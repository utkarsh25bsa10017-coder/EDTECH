# Public settings baked into the static build (web/ and the native app).
# Copy to .env and fill in. Never put secrets here: everything PUBLIC_ ships to browsers.

# API origin. Empty = same origin (the Rust server serves web/dist). The native app sets a full URL.
PUBLIC_API_BASE=

# WhatsApp number for "talk to us" links, international format without +, e.g. 919876543210.
PUBLIC_WHATSAPP_NUMBER=

# Meta Pixel id. Empty = the pixel is not loaded at all.
PUBLIC_META_PIXEL_ID=

# Checkout links. Fallback for every plan:
PUBLIC_CHECKOUT_URL=
# Per exam and tier (PROBABLE = ₹249 most-probable set, FAST2 = ₹499 2-month, PASS = ₹999 3-month / full Pass):
PUBLIC_CHECKOUT_URL_BPSC_TRE_PROBABLE=
PUBLIC_CHECKOUT_URL_BPSC_TRE_FAST2=
PUBLIC_CHECKOUT_URL_BPSC_TRE_PASS=
PUBLIC_CHECKOUT_URL_BPSC_CCE_PROBABLE=
PUBLIC_CHECKOUT_URL_BPSC_CCE_FAST2=
PUBLIC_CHECKOUT_URL_BPSC_CCE_PASS=
PUBLIC_CHECKOUT_URL_MPPSC_PROBABLE=
PUBLIC_CHECKOUT_URL_MPPSC_FAST2=
PUBLIC_CHECKOUT_URL_MPPSC_PASS=
PUBLIC_CHECKOUT_URL_RAS_PROBABLE=
PUBLIC_CHECKOUT_URL_RAS_FAST2=
PUBLIC_CHECKOUT_URL_RAS_PASS=
PUBLIC_CHECKOUT_URL_BIHAR_STET_PROBABLE=
PUBLIC_CHECKOUT_URL_BIHAR_STET_FAST2=
PUBLIC_CHECKOUT_URL_BIHAR_STET_PASS=
PUBLIC_CHECKOUT_URL_CTET_PROBABLE=
PUBLIC_CHECKOUT_URL_CTET_FAST2=
PUBLIC_CHECKOUT_URL_CTET_PASS=
PUBLIC_CHECKOUT_URL_CG_TET_PROBABLE=
PUBLIC_CHECKOUT_URL_CG_TET_FAST2=
PUBLIC_CHECKOUT_URL_CG_TET_PASS=
# Bundles (₹799):
PUBLIC_CHECKOUT_URL_BUNDLE_TRE_CTET=
PUBLIC_CHECKOUT_URL_BUNDLE_TRE_STET=

# Build-only (not PUBLIC): canonical origin and base path.
# SITE_URL=https://example.com
# BASE_PATH=/
