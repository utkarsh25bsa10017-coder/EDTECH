---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DESCRIPTION, SITE_NAME } from '../config.ts';
import { href } from '../lib/url.ts';
import type { Exam } from '../lib/exams.ts';

interface Props {
  /** Page title; the site name is appended unless it is already present. */
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  exam?: Exam;
  page?: 'pricing';
  /** Full-screen test pages hide the site header and footer. */
  bare?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description = DESCRIPTION, jsonLd, noindex, exam, page, bare, ogType = 'website' } = Astro.props;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const site = Astro.site;
const canonical = site && !noindex ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL(href('/og.png'), site).href : href('/og.png');
const ld = (jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []).map((d) =>
  JSON.stringify(d).replace(/</g, '\\u003c'),
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1015" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {site && <link rel="sitemap" href={href('/sitemap-index.xml')} />}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem('pq-theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
          var u = localStorage.getItem('pq-ui');
          if (!u) u = (navigator.language || '').toLowerCase().indexOf('hi') === 0 ? 'hi' : 'en';
          if (u === 'hi') d.dataset.ui = 'hi';
        } catch (e) {}
      })();
    </script>
    {ld.map((json) => <script type="application/ld+json" set:html={json} />)}
  </head>
  <body>
    <a class="skip-link" href="#main"><span class="l-en">Skip to content</span><span class="l-hi" lang="hi">सामग्री पर जाएं</span></a>
    {!bare && <Header exam={exam} page={page} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import { initPrefs } from '../scripts/prefs.ts';
      initPrefs();
    </script>
  </body>
</html>
