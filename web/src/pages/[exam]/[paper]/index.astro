---
import Base from '../../../layouts/Base.astro';
import L from '../../../components/L.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { allPapers, durationLabel, EXAM_INFO, KIND_LABEL, maxMarks, questionCount, topicsOf, type Paper } from '../../../lib/exams.ts';
import { examUrl, modeUrl } from '../../../lib/url.ts';

export function getStaticPaths() {
  return allPapers().map((paper) => ({ params: { exam: paper.exam, paper: paper.id }, props: { paper } }));
}

const { paper } = Astro.props as { paper: Paper };
const exam = paper.exam;
const info = EXAM_INFO[exam];
const total = questionCount(paper);
const dur = durationLabel(paper.duration_minutes);
const topics = topicsOf(paper);
const modes = [
  { mode: 'practice', primary: true, name: { en: 'Practice', hi: 'अभ्यास' }, desc: { en: 'Answer one question at a time and see the explanation straight away. No timer.', hi: 'एक-एक प्रश्न हल करें और तुरंत व्याख्या देखें। समय सीमा नहीं।' } },
  { mode: 'test', primary: false, name: { en: 'Mock test', hi: 'मॉक टेस्ट' }, desc: { en: 'Timed, like the computer-based exam: palette, mark for review, auto-submit, full report.', hi: 'कंप्यूटर आधारित परीक्षा जैसा समयबद्ध: पैलेट, समीक्षा हेतु चिह्नित, स्वतः जमा, पूरी रिपोर्ट।' } },
  { mode: 'omr', primary: false, name: { en: 'Paper + OMR', hi: 'प्रश्नपत्र + ओएमआर' }, desc: { en: 'Read the paper and fill bubbles on an on-screen OMR sheet against the clock.', hi: 'प्रश्नपत्र पढ़ें और समय के भीतर स्क्रीन पर ओएमआर शीट के गोले भरें।' } },
  { mode: 'booklet', primary: false, name: { en: 'Printable paper', hi: 'प्रिंट योग्य प्रश्नपत्र' }, desc: { en: 'Exam-style booklet in Hindi and English with answer key. Print or save as PDF.', hi: 'हिन्दी और अंग्रेज़ी में परीक्षा जैसी पुस्तिका, उत्तर कुंजी सहित। प्रिंट करें या पीडीएफ़ सहेजें।' } },
  { mode: 'sheet', primary: false, name: { en: 'OMR sheet', hi: 'ओएमआर शीट' }, desc: { en: 'A printable OMR answer sheet matched to this paper.', hi: 'इस प्रश्नपत्र से मेल खाती प्रिंट योग्य ओएमआर उत्तर शीट।' } },
] as const;
---
<Base
  title={`${info.short.en} ${paper.title.en}: free practice`}
  description={`${info.name.en}, ${paper.title.en}: ${total} questions in Hindi and English with explanations. Practice, timed mock test, OMR and printable paper.`}
  exam={exam}
  viewContent
>
  <div class="container">
    <Breadcrumbs items={[{ label: info.short, href: examUrl(exam) }, { label: paper.title, href: '' }]} />
  </div>
  <section class="container block">
    <p class="eyebrow"><L t={info.short} /> · <L t={KIND_LABEL[paper.kind]} /></p>
    <h1><L t={paper.title} /></h1>
    <p class="muted">
      <L t={{ en: `${total} questions · ${dur.en} · ${maxMarks(paper)} marks${paper.negative_marking > 0 ? ` · −${paper.negative_marking} per wrong answer` : ' · no negative marking'}`, hi: `${total} प्रश्न · ${dur.hi} · ${maxMarks(paper)} अंक${paper.negative_marking > 0 ? ` · गलत उत्तर पर −${paper.negative_marking}` : ' · ऋणात्मक अंकन नहीं'}` }} />
    </p>
    {paper.status === 'draft' && (
      <p class="note"><L en="Draft set: answers are still being checked by subject experts. If you spot a mistake, tell us." hi="ड्राफ़्ट सेट: उत्तरों की जांच विषय विशेषज्ञ कर रहे हैं। कोई गलती दिखे तो हमें बताएं।" /></p>
    )}
    <div class="modes">
      {modes.map((m) => (
        <a class:list={['panel', 'card-link', 'mode', { primary: m.primary }]} href={modeUrl(exam, paper.id, m.mode)}>
          <h2 class="h-sm"><L t={m.name} /></h2>
          <p class="muted small"><L t={m.desc} /></p>
          <span class:list={['btn', 'btn-block', { 'btn-primary': m.primary }]}><L en="Open" hi="खोलें" /></span>
        </a>
      ))}
    </div>
  </section>
  <section class="container block">
    <div class="panel">
      <h2 class="h-sm"><L en="Topics in this set" hi="इस सेट के विषय" /></h2>
      <ul class="topic-chips">{topics.map((t) => <li><L t={t} /></li>)}</ul>
      <p class="muted small" data-last></p>
    </div>
  </section>
</Base>

<script>
  // Show the last score saved on this device.
  const el = document.querySelector<HTMLElement>('[data-last]');
  const key = `pq-last:${location.pathname.split('/').filter(Boolean).slice(-2).join('/')}`;
  try {
    const last = JSON.parse(localStorage.getItem(key) || 'null');
    if (el && last && typeof last.score === 'number') {
      el.innerHTML = `<span class="l-en" lang="en">Your last mock-test score on this device: ${last.score} / ${last.max}</span><span class="l-hi" lang="hi">इस डिवाइस पर आपका पिछला मॉक टेस्ट स्कोर: ${last.score} / ${last.max}</span>`;
    }
  } catch {
    /* ignore */
  }
</script>

<style>
  .modes {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .modes .panel + .panel {
    margin-top: 0;
  }
  .mode {
    display: flex;
    flex-direction: column;
  }
  .mode .btn {
    margin-top: auto;
  }
  .mode.primary {
    border-color: var(--accent);
  }
  .topic-chips {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .topic-chips li {
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--panel-solid);
    font-size: 0.9rem;
  }
</style>
