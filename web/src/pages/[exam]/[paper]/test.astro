---
import Base from '../../../layouts/Base.astro';
import L from '../../../components/L.astro';
import Icon from '../../../components/Icon.astro';
import { allPapers, durationLabel, EXAM_INFO, maxMarks, paperJson, questionCount, type Exam, type Paper } from '../../../lib/exams.ts';
import { examUrl, practiceUrl } from '../../../lib/url.ts';
import { SITE_NAME } from '../../../config.ts';
import '../../../styles/quiz.css';

export function getStaticPaths() {
  return allPapers().map((paper) => ({ params: { exam: paper.exam, paper: paper.id }, props: { paper } }));
}

const { paper } = Astro.props as { paper: Paper };
const exam = paper.exam as Exam;
const info = EXAM_INFO[exam];
const total = questionCount(paper);
const dur = durationLabel(paper.duration_minutes);
---
<Base title={`${info.short.en} ${paper.title.en}: mock test`} exam={exam} bare noindex>
  <div class="cbt" data-cbt>
    <header class="cbt-bar">
      <a class="cbt-brand" href={examUrl(exam)}>{SITE_NAME}</a>
      <span class="cbt-title"><L t={info.short} /> · <L t={paper.title} /></span>
      <span class="cbt-timer" data-timer hidden aria-live="off"></span>
      <button class="lang-btn" type="button" data-lang-toggle>
        <span class="l-en" lang="hi">हिन्दी</span>
        <span class="l-hi" lang="en">English</span>
      </button>
    </header>

    <!-- 1. Instructions -->
    <section class="cbt-intro container" data-intro>
      <h1><L en="Mock test instructions" hi="मॉक टेस्ट के निर्देश" /></h1>
      <ul class="intro-facts">
        <li><Icon name="list" /><L t={{ en: `${total} questions in ${paper.sections.length} sections`, hi: `${paper.sections.length} खण्डों में ${total} प्रश्न` }} /></li>
        <li><Icon name="clock" /><L t={dur} /></li>
        <li><Icon name="target" /><L t={{ en: `${maxMarks(paper)} marks, +${paper.marks_per_question} per right answer${paper.negative_marking > 0 ? `, −${paper.negative_marking} per wrong answer` : ', no negative marking'}`, hi: `${maxMarks(paper)} अंक, सही उत्तर पर +${paper.marks_per_question}${paper.negative_marking > 0 ? `, गलत उत्तर पर −${paper.negative_marking}` : ', ऋणात्मक अंकन नहीं'}` }} /></li>
      </ul>
      <ol class="intro-rules">
        <li><L en="The clock starts when you press Start and the test submits itself when time runs out." hi="स्टार्ट दबाते ही समय शुरू होगा और समय समाप्त होने पर टेस्ट अपने आप जमा हो जाएगा।" /></li>
        <li><L en="Save & Next records your answer and moves on. Mark for Review flags a question to come back to." hi="सेव एवं नेक्स्ट आपका उत्तर सहेजकर आगे बढ़ता है। समीक्षा हेतु चिह्नित करने से प्रश्न बाद में देखने के लिए चिह्नित हो जाता है।" /></li>
        <li><L en="Answers marked for review are still counted when you submit." hi="समीक्षा हेतु चिह्नित उत्तर भी जमा करने पर गिने जाएंगे।" /></li>
        <li><L en="Use the question palette to jump to any question. Its colours show each question’s status." hi="किसी भी प्रश्न पर जाने के लिए प्रश्न पैलेट का प्रयोग करें। इसके रंग हर प्रश्न की स्थिति बताते हैं।" /></li>
      </ol>
      <div class="legend legend-intro" aria-hidden="true">
        <span><i class="st st-nv">1</i><L en="Not visited" hi="नहीं देखा" /></span>
        <span><i class="st st-na">2</i><L en="Not answered" hi="उत्तर नहीं दिया" /></span>
        <span><i class="st st-a">3</i><L en="Answered" hi="उत्तर दिया" /></span>
        <span><i class="st st-m">4</i><L en="Marked for review" hi="समीक्षा हेतु चिह्नित" /></span>
        <span><i class="st st-am">5</i><L en="Answered & marked" hi="उत्तर दिया व चिह्नित" /></span>
      </div>
      {paper.status === 'draft' && (
        <p class="draft-note"><L en="Draft set: still being checked by subject experts." hi="ड्राफ़्ट सेट: विषय विशेषज्ञों द्वारा जांच जारी है।" /></p>
      )}
      <label class="agree"><input type="checkbox" data-agree /> <L en="I have read the instructions." hi="मैंने निर्देश पढ़ लिए हैं।" /></label>
      <div class="intro-actions">
        <button class="btn btn-primary" type="button" data-start disabled><L en="Start test" hi="टेस्ट शुरू करें" /><Icon name="arrow-right" /></button>
        <button class="btn btn-quiet" type="button" data-resume hidden><L en="Resume my test" hi="मेरा टेस्ट जारी रखें" /></button>
        <a class="btn btn-quiet" href={practiceUrl(exam, paper.id)}><L en="Practise first" hi="पहले अभ्यास करें" /></a>
      </div>
    </section>

    <!-- 2. The exam -->
    <section class="cbt-main" data-exam hidden>
      <div class="cbt-left">
        <nav class="sec-tabs" data-sec-tabs aria-label="Sections"></nav>
        <div class="cbt-q" data-q aria-live="polite"></div>
        <div class="cbt-actions">
          <button class="btn btn-quiet" type="button" data-mark><Icon name="flag" /><L en="Mark for review & next" hi="समीक्षा हेतु चिह्नित करें व आगे" /></button>
          <button class="btn btn-quiet" type="button" data-clear><L en="Clear response" hi="उत्तर हटाएं" /></button>
          <button class="btn btn-primary" type="button" data-save><L en="Save & next" hi="सेव एवं नेक्स्ट" /></button>
        </div>
      </div>
      <aside class="cbt-right" data-palette-wrap>
        <button class="btn btn-quiet palette-toggle" type="button" data-palette-toggle><Icon name="list" /><L en="Question palette" hi="प्रश्न पैलेट" /></button>
        <div class="palette-body" data-palette-body>
          <div class="legend" data-legend></div>
          <div class="palette" data-palette></div>
          <button class="btn btn-primary submit-btn" type="button" data-submit><L en="Submit test" hi="टेस्ट जमा करें" /></button>
        </div>
      </aside>
    </section>

    <dialog class="confirm" data-confirm>
      <h2><L en="Submit the test?" hi="टेस्ट जमा करें?" /></h2>
      <div data-confirm-body></div>
      <div class="confirm-actions">
        <button class="btn btn-quiet" type="button" data-cancel><L en="Keep going" hi="जारी रखें" /></button>
        <button class="btn btn-primary" type="button" data-confirm-yes><L en="Submit" hi="जमा करें" /></button>
      </div>
    </dialog>

    <!-- 3. Result -->
    <section class="cbt-result container" data-result hidden></section>
  </div>
  <script type="application/json" id="paper-data" set:html={paperJson(paper)} />
</Base>

<script>
  import { bi, esc, forget, items, LETTERS, load, loadPaper, save, topicStats, topicTable, tr, type Item } from '../../../scripts/quiz.ts';

  type Status = 'nv' | 'na' | 'a' | 'm' | 'am';
  interface Run {
    answers: Record<string, number>;
    status: Record<string, Status>;
    marked: Record<string, boolean>;
    pos: number;
    endsAt: number;
    startedAt: number;
  }

  const paper = loadPaper();
  const all = items(paper);
  const KEY = `pq-test:${paper.exam}/${paper.id}`;
  const LAST = `${KEY}:last`;

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const intro = $('[data-intro]');
  const examEl = $('[data-exam]');
  const resultEl = $('[data-result]');
  const timerEl = $('[data-timer]');
  const qEl = $('[data-q]');
  const palette = $('[data-palette]');
  const legend = $('[data-legend]');
  const tabs = $('[data-sec-tabs]');
  const dialog = $<HTMLDialogElement>('[data-confirm]');

  let run: Run | null = null;
  let tick = 0;

  /* ------------------------------------------------------------ intro */
  const agree = $<HTMLInputElement>('[data-agree]');
  const startBtn = $<HTMLButtonElement>('[data-start]');
  agree.addEventListener('change', () => (startBtn.disabled = !agree.checked));

  const saved = load<Run>(KEY);
  if (saved && saved.endsAt > Date.now()) {
    const resume = $<HTMLButtonElement>('[data-resume]');
    resume.hidden = false;
    resume.addEventListener('click', () => begin(saved));
  } else if (saved) {
    forget(KEY);
  }

  startBtn.addEventListener('click', () => {
    const status: Record<string, Status> = {};
    for (const it of all) status[it.q.id] = 'nv';
    const now = Date.now();
    begin({ answers: {}, status, marked: {}, pos: 0, startedAt: now, endsAt: now + paper.duration_minutes * 60_000 });
  });

  function begin(r: Run) {
    run = r;
    intro.hidden = true;
    resultEl.hidden = true;
    examEl.hidden = false;
    timerEl.hidden = false;
    visit(run.pos);
    tick = window.setInterval(updateTimer, 1000);
    updateTimer();
    window.addEventListener('beforeunload', guard);
  }

  function guard(e: BeforeUnloadEvent) {
    e.preventDefault();
  }

  /* ------------------------------------------------------------ timer */
  function updateTimer() {
    if (!run) return;
    const left = Math.max(0, run.endsAt - Date.now());
    const m = Math.floor(left / 60000);
    const s = Math.floor((left % 60000) / 1000);
    timerEl.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    timerEl.classList.toggle('low', left < 5 * 60000);
    if (left === 0) finish(true);
  }

  /* ------------------------------------------------------------ question */
  function statusOf(id: string): Status {
    return run!.status[id] ?? 'nv';
  }

  function visit(i: number) {
    const r = run!;
    r.pos = i;
    const id = all[i].q.id;
    if (statusOf(id) === 'nv') r.status[id] = 'na';
    save(KEY, r);
    renderQ();
    renderPalette();
    renderTabs();
  }

  function renderQ() {
    const r = run!;
    const it = all[r.pos];
    const chosen = r.answers[it.q.id];
    qEl.innerHTML = `
      <div class="cbt-qhead"><strong>${bi(tr(`Question No. ${it.n}`, `प्रश्न संख्या ${it.n}`))}</strong>
        <span class="muted">${bi(tr(`+${paper.marks_per_question}`, `+${paper.marks_per_question}`))}${paper.negative_marking > 0 ? ` / −${paper.negative_marking}` : ''}</span></div>
      <p class="q-text">${bi(it.q.text)}</p>
      <ol class="cbt-opts">${it.q.options
        .map(
          (o, i) => `<li><label class="cbt-opt"><input type="radio" name="opt" value="${i}" ${chosen === i ? 'checked' : ''}/>
          <span class="ol">${LETTERS[i]}</span><span>${bi(o)}</span></label></li>`,
        )
        .join('')}</ol>`;
  }

  function selected(): number | null {
    const el = qEl.querySelector<HTMLInputElement>('input[name="opt"]:checked');
    return el ? Number(el.value) : null;
  }

  function next() {
    if (run!.pos < all.length - 1) visit(run!.pos + 1);
    else renderPalette();
  }

  $('[data-save]').addEventListener('click', () => {
    const r = run!;
    const id = all[r.pos].q.id;
    const s = selected();
    if (s === null) {
      delete r.answers[id];
      r.status[id] = r.marked[id] ? 'm' : 'na';
    } else {
      r.answers[id] = s;
      r.marked[id] = false;
      r.status[id] = 'a';
    }
    next();
  });

  $('[data-mark]').addEventListener('click', () => {
    const r = run!;
    const id = all[r.pos].q.id;
    const s = selected();
    r.marked[id] = true;
    if (s === null) {
      delete r.answers[id];
      r.status[id] = 'm';
    } else {
      r.answers[id] = s;
      r.status[id] = 'am';
    }
    next();
  });

  $('[data-clear]').addEventListener('click', () => {
    const r = run!;
    const id = all[r.pos].q.id;
    delete r.answers[id];
    r.marked[id] = false;
    r.status[id] = 'na';
    save(KEY, r);
    renderQ();
    renderPalette();
  });

  /* ------------------------------------------------------------ palette */
  const LEG: [Status, ReturnType<typeof tr>][] = [
    ['a', tr('Answered', 'उत्तर दिया')],
    ['na', tr('Not answered', 'उत्तर नहीं दिया')],
    ['nv', tr('Not visited', 'नहीं देखा')],
    ['m', tr('Marked', 'चिह्नित')],
    ['am', tr('Answered & marked', 'उत्तर दिया व चिह्नित')],
  ];

  function counts() {
    const c: Record<Status, number> = { nv: 0, na: 0, a: 0, m: 0, am: 0 };
    for (const it of all) c[statusOf(it.q.id)]++;
    return c;
  }

  function renderPalette() {
    const r = run!;
    const c = counts();
    legend.innerHTML = LEG.map(([s, label]) => `<span><i class="st st-${s}">${c[s]}</i>${bi(label)}</span>`).join('');
    const sec = all[r.pos].section.id;
    palette.innerHTML = `<p class="pal-sec">${bi(all[r.pos].section.name)}</p><div class="pal-grid">${all
      .map((it, i) => (it.section.id !== sec ? '' : `<button type="button" class="st st-${statusOf(it.q.id)}" data-go="${i}" aria-current="${i === r.pos}" aria-label="Question ${it.n}">${it.n}</button>`))
      .join('')}</div>`;
    for (const b of palette.querySelectorAll<HTMLButtonElement>('[data-go]')) b.addEventListener('click', () => visit(Number(b.dataset.go)));
  }

  function renderTabs() {
    const cur = all[run!.pos].section.id;
    tabs.innerHTML = paper.sections
      .map((s) => `<button type="button" data-sec="${esc(s.id)}" aria-current="${s.id === cur}">${bi(s.name)}</button>`)
      .join('');
    for (const b of tabs.querySelectorAll<HTMLButtonElement>('[data-sec]')) {
      b.addEventListener('click', () => visit(all.findIndex((it) => it.section.id === b.dataset.sec)));
    }
  }

  $('[data-palette-toggle]').addEventListener('click', () => $('[data-palette-wrap]').classList.toggle('open'));

  /* ------------------------------------------------------------ submit */
  $('[data-submit]').addEventListener('click', () => {
    const c = counts();
    $('[data-confirm-body]').innerHTML = `<ul class="confirm-list">${LEG.map(([s, label]) => `<li><i class="st st-${s}">${c[s]}</i>${bi(label)}</li>`).join('')}</ul>`;
    dialog.showModal();
  });
  $('[data-cancel]').addEventListener('click', () => dialog.close());
  $('[data-confirm-yes]').addEventListener('click', () => {
    dialog.close();
    finish(false);
  });

  interface Result {
    answers: Record<string, number>;
    seconds: number;
    timedOut: boolean;
    at: number;
  }

  function finish(timedOut: boolean) {
    if (!run) return;
    clearInterval(tick);
    window.removeEventListener('beforeunload', guard);
    const res: Result = {
      answers: run.answers,
      seconds: Math.round((Math.min(Date.now(), run.endsAt) - run.startedAt) / 1000),
      timedOut,
      at: Date.now(),
    };
    save(LAST, res);
    forget(KEY);
    run = null;
    if (dialog.open) dialog.close();
    showResult(res);
  }

  /* ------------------------------------------------------------ result */
  function showResult(res: Result) {
    examEl.hidden = true;
    intro.hidden = true;
    timerEl.hidden = true;
    resultEl.hidden = false;
    const chosen = (id: string) => res.answers[id];
    const right = all.filter((it) => chosen(it.q.id) === it.q.answer).length;
    const attempted = all.filter((it) => chosen(it.q.id) !== undefined).length;
    const wrong = attempted - right;
    const score = right * paper.marks_per_question - wrong * paper.negative_marking;
    const max = all.length * paper.marks_per_question;
    const acc = attempted ? Math.round((right / attempted) * 100) : 0;
    const mm = Math.floor(res.seconds / 60);
    const ss = res.seconds % 60;
    const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(2));

    const secRows = paper.sections
      .map((s) => {
        const its = all.filter((it) => it.section.id === s.id);
        const r = its.filter((it) => chosen(it.q.id) === it.q.answer).length;
        const a = its.filter((it) => chosen(it.q.id) !== undefined).length;
        const sc = r * paper.marks_per_question - (a - r) * paper.negative_marking;
        return `<tr><td>${bi(s.name)}</td><td>${a}/${its.length}</td><td>${r}</td><td>${a - r}</td><td><strong>${fmt(sc)}</strong></td></tr>`;
      })
      .join('');

    resultEl.innerHTML = `
      <h1>${bi(tr('Your result', 'आपका परिणाम'))}</h1>
      ${res.timedOut ? `<p class="draft-note">${bi(tr('Time ran out, so the test was submitted automatically.', 'समय समाप्त हो गया, इसलिए टेस्ट अपने आप जमा हो गया।'))}</p>` : ''}
      <div class="score card"><span class="score-num">${fmt(score)}<small>/${max}</small></span><span>${bi(tr('Score', 'प्राप्तांक'))}</span></div>
      <ul class="stats">
        <li><strong>${right}</strong>${bi(tr('right', 'सही'))}</li>
        <li><strong>${wrong}</strong>${bi(tr('wrong', 'गलत'))}</li>
        <li><strong>${all.length - attempted}</strong>${bi(tr('skipped', 'छोड़े'))}</li>
        <li><strong>${acc}%</strong>${bi(tr('accuracy', 'सटीकता'))}</li>
        <li><strong>${mm}:${String(ss).padStart(2, '0')}</strong>${bi(tr('time taken', 'लगा समय'))}</li>
      </ul>
      <h2>${bi(tr('By section', 'खण्डवार'))}</h2>
      <table class="topics"><thead><tr><th>${bi(tr('Section', 'खण्ड'))}</th><th>${bi(tr('Attempted', 'हल किए'))}</th><th>${bi(tr('Right', 'सही'))}</th><th>${bi(tr('Wrong', 'गलत'))}</th><th>${bi(tr('Score', 'अंक'))}</th></tr></thead><tbody>${secRows}</tbody></table>
      <h2>${bi(tr('By topic', 'विषयवार'))}</h2>
      ${topicTable(topicStats(all, chosen)) || `<p class="muted">${bi(tr('No questions attempted.', 'कोई प्रश्न हल नहीं किया।'))}</p>`}
      <div class="res-actions">
        <button class="btn btn-primary" type="button" data-retake>${bi(tr('Take the test again', 'टेस्ट दोबारा दें'))}</button>
      </div>
      <h2>${bi(tr('Solutions', 'हल'))}</h2>
      <div class="filters" data-sol-filter role="group">
        <button type="button" class="chip" data-sf="all" aria-pressed="true">${bi(tr('All', 'सभी'))}</button>
        <button type="button" class="chip" data-sf="wrong" aria-pressed="false">${bi(tr('Wrong', 'गलत'))}</button>
        <button type="button" class="chip" data-sf="skipped" aria-pressed="false">${bi(tr('Skipped', 'छोड़े'))}</button>
      </div>
      <ol class="sols" data-sols>${all.map((it) => solution(it, chosen(it.q.id))).join('')}</ol>`;

    resultEl.querySelector('[data-retake]')!.addEventListener('click', () => location.reload());
    for (const b of resultEl.querySelectorAll<HTMLButtonElement>('[data-sf]')) {
      b.addEventListener('click', () => {
        for (const o of resultEl.querySelectorAll('[data-sf]')) o.setAttribute('aria-pressed', String(o === b));
        for (const li of resultEl.querySelectorAll<HTMLElement>('[data-state]')) {
          li.hidden = b.dataset.sf !== 'all' && li.dataset.state !== b.dataset.sf;
        }
      });
    }
    window.scrollTo(0, 0);
  }

  function solution(it: Item, c: number | undefined): string {
    const state = c === undefined ? 'skipped' : c === it.q.answer ? 'right' : 'wrong';
    const opts = it.q.options
      .map((o, i) => {
        const cls = i === it.q.answer ? 'right' : i === c ? 'wrong' : '';
        return `<li class="sol-opt ${cls}"><span class="ol">${LETTERS[i]}</span>${bi(o)}</li>`;
      })
      .join('');
    const label = { right: tr('Right', 'सही'), wrong: tr('Wrong', 'गलत'), skipped: tr('Skipped', 'छोड़ा') }[state];
    return `<li class="card sol" data-state="${state}"><div class="q-meta"><span>${bi(tr(`Q${it.n}`, `प्र.${it.n}`))}</span><span class="badge">${bi(it.q.topic)}</span><span class="badge st-${state}">${bi(label)}</span></div>
      <p class="q-text">${bi(it.q.text)}</p><ul class="sol-opts">${opts}</ul><p class="sol-exp">${bi(it.q.explanation)}</p></li>`;
  }
</script>

<style is:global>
  .cbt-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem var(--gutter);
    background: var(--ink);
    color: var(--bg);
  }

  .cbt-brand {
    color: var(--bg);
    font-weight: 800;
    text-decoration: none;
  }

  .cbt-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
    opacity: 0.85;
  }

  .cbt-timer {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    font-size: 1.15rem;
    padding: 0.15rem 0.6rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--bg) 15%, transparent);
  }

  .cbt-timer.low {
    background: var(--bad);
    color: #fff;
  }

  .cbt-bar .lang-btn {
    min-height: 34px;
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--bg) 40%, transparent);
    background: transparent;
    color: var(--bg);
    font: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .cbt-intro,
  .cbt-result {
    max-width: 52rem;
    padding-block: 1.75rem 3rem;
  }

  .intro-facts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-weight: 600;
  }

