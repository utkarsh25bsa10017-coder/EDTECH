---
import Base from '../../layouts/Base.astro';
import L from '../../components/L.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Syllabus from '../../components/Syllabus.astro';
import PricingLadder from '../../components/PricingLadder.astro';
import EmptyState from '../../components/EmptyState.astro';
import { durationLabel, EXAMS, EXAM_INFO, KIND_LABEL, papersFor, questionCount, TENTATIVE, type Exam } from '../../lib/exams.ts';
import { modeUrl, paperUrl } from '../../lib/url.ts';
import { whatsappUrl } from '../../config.ts';

export function getStaticPaths() {
  return EXAMS.map((exam) => ({ params: { exam } }));
}

const exam = Astro.params.exam as Exam;
const info = EXAM_INFO[exam];
const free = papersFor(exam);
const first = free[0];
const wa = whatsappUrl(`Hi, please send me the free ${info.short.en} practice set.`);
---
<Base
  title={`${info.short.en}: free practice questions, mock tests and syllabus`}
  description={`${info.name.en}: free practice questions in Hindi and English, timed mock tests, syllabus and exam timing. Independent practice platform.`}
  exam={exam}
  viewContent
>
  <div class="container">
    <Breadcrumbs items={[{ label: info.short, href: '' }]} />
  </div>

  <section class="container block">
    <div class="panel exam-hero">
      <p class="eyebrow"><L t={info.state} /> · <L t={info.body} /></p>
      <h1><L t={info.name} /></h1>
      <p class="lead"><L t={info.blurb} /></p>
      <dl class="meta">
        <div><dt><L en="Expected exam" hi="संभावित परीक्षा" /></dt><dd><L t={info.timing} /> <span class="muted small">(<L t={TENTATIVE} />)</span></dd></div>
        {info.website && <div><dt><L en="Official website" hi="आधिकारिक वेबसाइट" /></dt><dd><a href={info.website} target="_blank" rel="noopener">{info.website.replace(/^https?:\/\//, '')}</a></dd></div>}
      </dl>
      <div class="row-actions">
        {first ? (
          <a class="btn btn-primary btn-lg" href={modeUrl(exam, first.id, 'practice')}><L en="Start free questions" hi="मुफ़्त प्रश्न शुरू करें" /></a>
        ) : wa ? (
          <a class="btn btn-primary btn-lg" href={wa} target="_blank" rel="noopener"><L en="Get the free set on WhatsApp" hi="मुफ़्त सेट व्हाट्सऐप पर पाएं" /></a>
        ) : null}
        <a class="btn btn-lg" href="#pricing"><L en="See packs" hi="पैक देखें" /></a>
      </div>
      <p class="muted small"><L en="No sign-up needed for the free questions." hi="मुफ़्त प्रश्नों के लिए साइन-अप ज़रूरी नहीं।" /></p>
    </div>
  </section>

  <section class="container block" id="papers" aria-labelledby="papers-h">
    <h2 id="papers-h"><L en="Papers" hi="प्रश्नपत्र" /></h2>
    <div class="panel">
      <h3 class="h-sm"><L en="Free" hi="मुफ़्त" /></h3>
      {free.length ? (
        <ul class="paper-list">
          {free.map((p) => (
            <li class="paper-item">
              <div class="paper-meta">
                <span class="tag tag-ok"><L t={KIND_LABEL.free} /></span>
                {p.status === 'draft' && <span class="tag"><L en="Draft" hi="ड्राफ़्ट" /></span>}
                <h3 class="h-sm"><a href={paperUrl(exam, p.id)}><L t={p.title} /></a></h3>
                <p class="muted small"><L t={{ en: `${questionCount(p)} questions · ${durationLabel(p.duration_minutes).en}`, hi: `${questionCount(p)} प्रश्न · ${durationLabel(p.duration_minutes).hi}` }} /></p>
              </div>
              <div class="row-actions">
                <a class="btn btn-primary" href={modeUrl(exam, p.id, 'practice')}><L en="Practice" hi="अभ्यास" /></a>
                <a class="btn" href={modeUrl(exam, p.id, 'test')}><L en="Mock test" hi="मॉक टेस्ट" /></a>
                <a class="btn btn-quiet" href={paperUrl(exam, p.id)}><L en="More" hi="और" /></a>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState title={{ en: 'The free set for this exam is being prepared.', hi: 'इस परीक्षा का मुफ़्त सेट तैयार हो रहा है।' }}>
          <p class="muted small"><L en="Questions are checked before they go live. Meanwhile, try a free set from another exam: general studies and pedagogy overlap a lot." hi="प्रश्न जांच के बाद ही उपलब्ध होते हैं। तब तक किसी अन्य परीक्षा का मुफ़्त सेट आज़माएं: सामान्य अध्ययन और शिक्षाशास्त्र काफ़ी मिलते हैं।" /></p>
        </EmptyState>
      )}
      <h3 class="h-sm paid-h"><L en="Mocks and most-probable sets" hi="मॉक और संभावित प्रश्न सेट" /></h3>
      <div data-paid-papers data-exam={exam} data-static={free.map((p) => p.id).join(',')}>
        <p class="muted small"><L en="Loading…" hi="लोड हो रहा है…" /></p>
      </div>
    </div>
  </section>

  <section class="container block" id="pricing" aria-labelledby="pricing-h">
    <h2 id="pricing-h"><L en="Packs" hi="पैक" /></h2>
    <PricingLadder exam={exam} />
  </section>

  <section class="container block" id="syllabus" aria-labelledby="syl-h">
    <h2 id="syl-h"><L en="Syllabus and pattern" hi="पाठ्यक्रम एवं पैटर्न" /></h2>
    <div class="panel">
      <Syllabus exam={exam} />
      <p class="muted small syl-foot"><L en="Summarised from published syllabi. The official notification is final." hi="प्रकाशित पाठ्यक्रम का सार। आधिकारिक अधिसूचना ही अंतिम है।" /></p>
    </div>
  </section>
</Base>

<script>
  import { initPaidPapers } from '../../scripts/papers.ts';
  void initPaidPapers();
</script>

<style>
  .lead {
    font-size: 1.1rem;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .meta {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 0;
  }
  .meta div {
    display: grid;
    gap: 0 1rem;
  }
  @media (min-width: 640px) {
    .meta div {
      grid-template-columns: 11rem 1fr;
    }
  }
  .meta dt {
    font-weight: 600;
    color: var(--muted);
  }
  .meta dd {
    margin: 0;
  }
  .paid-h {
    margin-top: 1.5rem;
  }
  .syl-foot {
    margin: 1rem 0 0;
  }
</style>
