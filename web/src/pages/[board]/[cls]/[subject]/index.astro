---
import type { GetStaticPaths } from 'astro';
import Base from '../../../../layouts/Base.astro';
import L from '../../../../components/L.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import PaperCard from '../../../../components/PaperCard.astro';
import type { Board, Kind, Lang } from '../../../../lib/schema.ts';
import {
  BOARD_INFO,
  KIND_LABEL,
  KIND_ORDER,
  LANG_LABEL,
  LANG_ORDER,
  PAPERS,
  classLabel,
  classSlug,
  countLabel,
  parseClassSlug,
  subjectName,
} from '../../../../lib/boards.ts';
import { papersWhere, subjectPairs } from '../../../../lib/catalog.ts';
import { boardUrl, classUrl, subjectUrl } from '../../../../lib/url.ts';

export const getStaticPaths = (() =>
  subjectPairs().map(({ board, cls, subject }) => ({
    params: { board, cls: classSlug(cls), subject },
  }))) satisfies GetStaticPaths;

const board = Astro.params.board as Board;
const cls = parseClassSlug(Astro.params.cls)!;
const subject = Astro.params.subject;
const info = BOARD_INFO[board];
const papers = papersWhere({ board, cls, subject });
const name = subjectName(papers[0]);
const cl = classLabel(cls);

const years = [...new Set(papers.map((p) => p.year))];
const kinds = KIND_ORDER.filter((k) => papers.some((p) => p.kind === k));
const langs = LANG_ORDER.filter((l) => papers.some((p) => p.lang === l));
const kindCount = (k: Kind) => papers.filter((p) => p.kind === k).length;
const langCount = (l: Lang) => papers.filter((p) => p.lang === l).length;
const answered = papers.filter((p) => p.solution_count > 0 || p.solution_pdf).length;
const yearRange = years.length > 1 ? `${years.at(-1)}–${years[0]}` : `${years[0]}`;
---
<Base
  title={`${info.short} Class ${cls} ${name.en} question papers (${yearRange})`}
  description={`${papers.length} ${info.short} Class ${cls} ${name.en} papers from ${yearRange}: ${kinds.map((k) => KIND_LABEL[k].en.toLowerCase() + 's').join(', ')}. Official PDFs${answered ? ' and marking schemes' : ''}.`}
  board={board}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: { en: info.short, hi: info.short }, href: boardUrl(board) },
        { label: cl, href: classUrl(board, cls) },
        { label: name, href: subjectUrl(board, cls, subject) },
      ]}
    />
    <header class="page-head">
      <p class="eyebrow">{info.short} · <L t={cl} /></p>
      <h1><L t={name} /></h1>
      <ul class="stat-line">
        <li><strong><L t={countLabel(papers.length, ...PAPERS)} /></strong></li>
        <li>{yearRange}</li>
        {answered > 0 && <li><L t={{ en: `${answered} with answers`, hi: `${answered} उत्तर सहित` }} /></li>}
      </ul>
    </header>

    {(kinds.length > 1 || langs.length > 1) && (
      <div class="filters no-print" data-filters hidden>
        {kinds.length > 1 && (
          <div class="filter-row" role="group" aria-label="Paper type">
            <span class="filter-label"><L en="Type" hi="प्रकार" /></span>
            <ul class="chips">
              <li><button class="chip" type="button" data-filter="kind" data-value="" aria-pressed="true"><L en="All" hi="सभी" /></button></li>
              {kinds.map((k) => (
                <li>
                  <button class="chip" type="button" data-filter="kind" data-value={k} aria-pressed="false">
                    <L t={KIND_LABEL[k]} /> <span class="count">{kindCount(k)}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}
        {langs.length > 1 && (
          <div class="filter-row" role="group" aria-label="Medium">
            <span class="filter-label"><L en="Medium" hi="माध्यम" /></span>
            <ul class="chips">
              <li><button class="chip" type="button" data-filter="lang" data-value="" aria-pressed="true"><L en="All" hi="सभी" /></button></li>
              {langs.map((l) => (
                <li>
                  <button class="chip" type="button" data-filter="lang" data-value={l} aria-pressed="false">
                    <L t={LANG_LABEL[l]} /> <span class="count">{langCount(l)}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}
        <p class="muted shown" aria-live="polite" data-shown></p>
      </div>
    )}

    {years.map((y) => (
      <section class="year" data-year aria-labelledby={`y-${y}`}>
        <h2 id={`y-${y}`}>{y}</h2>
        <div class="grid">
          {papers.filter((p) => p.year === y).map((p) => <PaperCard paper={p} />)}
        </div>
      </section>
    ))}
    <p class="empty-filter muted" data-none hidden>
      <L en="No papers match these filters." hi="इन फ़िल्टर से कोई प्रश्नपत्र मेल नहीं खाता।" />
    </p>
  </div>
</Base>

<script>
  // Client-side filters; without JS every paper stays visible.
  const box = document.querySelector<HTMLElement>('[data-filters]');
  if (box) {
    box.hidden = false;
    const state: Record<string, string> = { kind: '', lang: '' };
    const cards = [...document.querySelectorAll<HTMLElement>('.paper-card')];
    const shown = box.querySelector<HTMLElement>('[data-shown]')!;
    const none = document.querySelector<HTMLElement>('[data-none]')!;

    const apply = () => {
      let visible = 0;
      for (const card of cards) {
        const ok = (!state.kind || card.dataset.kind === state.kind) && (!state.lang || card.dataset.lang === state.lang);
        card.hidden = !ok;
        if (ok) visible++;
      }
      for (const sec of document.querySelectorAll<HTMLElement>('[data-year]')) {
        sec.hidden = !sec.querySelector('.paper-card:not([hidden])');
      }
      none.hidden = visible > 0;
      shown.innerHTML =
        `<span class="l-en" lang="en">Showing ${visible} of ${cards.length}</span>` +
        `<span class="l-hi" lang="hi">${cards.length} में से ${visible} दिखाए गए</span>`;
    };

    box.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const key = btn.dataset.filter!;
      state[key] = btn.dataset.value ?? '';
      for (const b of box.querySelectorAll<HTMLButtonElement>(`[data-filter="${key}"]`)) {
        b.setAttribute('aria-pressed', String(b === btn));
      }
      apply();
    });
    apply();
  }
</script>

<style>
  .filters {
    display: grid;
    gap: 0.65rem;
    margin: 0.75rem 0 0.25rem;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-label {
    min-width: 4.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .shown {
    margin: 0;
    font-size: 0.875rem;
  }

  .year {
    padding-top: 1.75rem;
  }

  .year h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.25rem;
    margin-bottom: 0.85rem;
  }

  .year h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .empty-filter {
    padding: 2rem 0;
    text-align: center;
  }
</style>
