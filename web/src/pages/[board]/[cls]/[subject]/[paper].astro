---
import type { GetStaticPaths } from 'astro';
import Base from '../../../../layouts/Base.astro';
import L from '../../../../components/L.astro';
import Icon from '../../../../components/Icon.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import PaperCard from '../../../../components/PaperCard.astro';
import { summarize, type QuestionRecord } from '../../../../lib/schema.ts';
import {
  BOARD_INFO,
  EXTRACTION_LABEL,
  KIND_LABEL,
  KIND_SHORT,
  LANG_LABEL,
  QUESTIONS,
  classLabel,
  classSlug,
  countLabel,
  durationLabel,
  marksLabel,
  paperName,
  sectionLabel,
  subjectName,
} from '../../../../lib/boards.ts';
import { allPapers, loadPaper, papersWhere } from '../../../../lib/catalog.ts';
import { boardUrl, classUrl, paperSlug, paperUrl, pdfAt, subjectUrl } from '../../../../lib/url.ts';
import { REPO_URL } from '../../../../config.ts';

export const getStaticPaths = (() =>
  allPapers().map((p) => ({
    params: { board: p.board, cls: classSlug(p.class), subject: p.subject_slug, paper: paperSlug(p) },
    props: { id: p.id },
  }))) satisfies GetStaticPaths;

const { id } = Astro.props;
const paper = loadPaper(id);
const s = summarize(paper);
const info = BOARD_INFO[paper.board];
const name = paperName(s);
const subj = subjectName(s);
const cl = classLabel(paper.class);
const contentLang = paper.lang === 'bi' ? undefined : paper.lang;

// Consecutive questions sharing a section form one group.
interface Group {
  section: string | null;
  anchor: string;
  questions: { q: QuestionRecord; anchor: string }[];
}
const groups: Group[] = [];
const usedAnchors = new Set<string>();
const anchorFor = (base: string) => {
  let a = base;
  for (let i = 2; usedAnchors.has(a); i++) a = `${base}-${i}`;
  usedAnchors.add(a);
  return a;
};
const slugify = (v: string) =>
  v.toLowerCase().normalize('NFKD').replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-+|-+$/g, '') || 'x';
for (const q of paper.questions) {
  let g = groups.at(-1);
  if (!g || g.section !== q.section) {
    g = { section: q.section, anchor: anchorFor(`section-${slugify(q.section ?? 'all')}`), questions: [] };
    groups.push(g);
  }
  g.questions.push({ q, anchor: anchorFor(`q-${slugify(q.number)}`) });
}
const showSections = groups.some((g) => g.section);
const groupMarks = (g: Group) => {
  const marks = g.questions.map(({ q }) => q.marks);
  return marks.every((m) => m !== null) ? marks.reduce((a, b) => a + (b ?? 0), 0) : null;
};

const siblings = papersWhere({ board: paper.board, cls: paper.class, subject: paper.subject_slug })
  .filter((p) => p.id !== id)
  .slice(0, 6);

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const issueUrl = `${REPO_URL}/issues/new?${new URLSearchParams({
  title: `Problem with ${paper.id}`,
  body: `Page: ${pageUrl}\nOfficial PDF: ${paper.paper_pdf}\n\nWhat is wrong?\n`,
})}`;

const suffix = s.solution_count > 0 ? 'with answers' : s.question_count > 0 ? 'questions' : 'PDF';
const description = [
  `${name.en}${paper.session ? ` (session ${paper.session})` : ''}.`,
  s.question_count > 0 ? `${s.question_count} questions${s.solution_count ? `, ${s.solution_count} with answers from the official marking scheme` : ''}.` : '',
  `Official PDF from ${info.body.en}.`,
]
  .filter(Boolean)
  .join(' ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: name.en,
  alternateName: paper.title,
  learningResourceType: KIND_LABEL[paper.kind].en,
  educationalLevel: `${info.short} Class ${paper.class}`,
  about: subj.en,
  inLanguage: paper.lang === 'bi' ? ['en', 'hi'] : paper.lang,
  isAccessibleForFree: true,
  ...(Astro.site ? { url: pageUrl } : {}),
  ...(paper.duration_minutes ? { timeRequired: `PT${paper.duration_minutes}M` } : {}),
  publisher: { '@type': 'Organization', name: info.name.en, url: info.website },
  encoding: [{ '@type': 'MediaObject', contentUrl: paper.paper_pdf, encodingFormat: 'application/pdf' }],
};
---
<Base title={`${name.en} ${suffix}`} description={description} jsonLd={jsonLd} board={paper.board} ogType="article">
  <div class="container narrow">
    <Breadcrumbs
      items={[
        { label: { en: info.short, hi: info.short }, href: boardUrl(paper.board) },
        { label: cl, href: classUrl(paper.board, paper.class) },
        { label: subj, href: subjectUrl(paper.board, paper.class, paper.subject_slug) },
        { label: { en: `${KIND_SHORT[paper.kind].en} ${paper.year}`, hi: `${KIND_SHORT[paper.kind].hi} ${paper.year}` }, href: paperUrl(s) },
      ]}
    />

    <article data-pagefind-body>
      <span data-pagefind-filter={`board:${paper.board}`}></span>
      <span data-pagefind-filter={`class:${paper.class}`}></span>
      <span data-pagefind-filter={`subject:${paper.subject_slug}`}></span>
      <span data-pagefind-filter={`kind:${paper.kind}`}></span>
      <span data-pagefind-filter={`year:${paper.year}`}></span>
      <span data-pagefind-filter={`lang:${paper.lang}`}></span>
      <span hidden data-pagefind-meta="title[data-v]" data-v={name.en}></span>
      <span hidden data-pagefind-meta="title_hi[data-v]" data-v={name.hi}></span>

      <header class="paper-head">
        <ul class="badges" data-pagefind-ignore>
          <li class={`badge kind-${paper.kind}`}><L t={KIND_LABEL[paper.kind]} /></li>
          <li class="badge outline">{paper.year}</li>
          <li class="badge outline"><L t={LANG_LABEL[paper.lang]} /></li>
          {paper.variant && <li class="badge outline"><L en="Set" hi="सेट" /> {paper.variant}</li>}
        </ul>
        <h1><L t={name} /></h1>
        <p class="orig" lang={contentLang}>
          <span class="muted" data-pagefind-ignore><L en="As published:" hi="प्रकाशित शीर्षक:" /></span> {paper.title}
        </p>

        <dl class="facts" data-pagefind-ignore>
          {paper.session && (
            <div><dt><L en="Session" hi="सत्र" /></dt><dd>{paper.session}</dd></div>
          )}
          {paper.duration_minutes && (
            <div><dt><L en="Time" hi="समय" /></dt><dd><L t={durationLabel(paper.duration_minutes)} /></dd></div>
          )}
          {paper.max_marks && (
            <div><dt><L en="Max. marks" hi="पूर्णांक" /></dt><dd>{paper.max_marks}</dd></div>
          )}
          <div>
            <dt><L en="On this page" hi="इस पेज पर" /></dt>
            <dd>
              {s.question_count > 0 ? (
                <L t={countLabel(s.question_count, ...QUESTIONS)} />
              ) : (
                <L t={EXTRACTION_LABEL['pdf-only']} />
              )}
              {s.solution_count > 0 && <L t={{ en: `, ${s.solution_count} answers`, hi: `, ${s.solution_count} उत्तर` }} />}
            </dd>
          </div>
        </dl>

        <div class="actions no-print" data-pagefind-ignore>
          <a class="btn btn-primary" href={paper.paper_pdf} rel="noopener" target="_blank">
            <Icon name="file" /><L en="Question paper PDF" hi="प्रश्नपत्र PDF" />
          </a>
          {paper.solution_pdf && (
            <a class="btn" href={paper.solution_pdf} rel="noopener" target="_blank">
              <Icon name="file-check" /><L en="Marking scheme PDF" hi="अंकन योजना PDF" />
            </a>
          )}
          <a class="btn btn-quiet" href={paper.source_page} rel="noopener" target="_blank">
            <L t={{ en: `Source: ${info.body.en}`, hi: `स्रोत: ${info.body.hi}` }} /><Icon name="external" />
          </a>
        </div>
      </header>

      {s.question_count === 0 ? (
        <div class="callout" data-pagefind-ignore>
          <Icon name="file" class="callout-icon" />
          <div>
            <h2><L en="Read this paper as a PDF" hi="यह प्रश्नपत्र PDF में पढ़ें" /></h2>
            <p>
              <L
                en="This paper is a scanned document or uses a font that can’t be converted to clean text, so we link the official PDF rather than show garbled questions."
                hi="यह प्रश्नपत्र स्कैन किया गया है या ऐसे फ़ॉन्ट में है जिसे साफ़ टेक्स्ट में नहीं बदला जा सकता, इसलिए गलत अक्षरों वाले प्रश्न दिखाने के बजाय हम आधिकारिक PDF का लिंक देते हैं।"
              />
            </p>
            <a class="btn btn-primary" href={paper.paper_pdf} rel="noopener" target="_blank">
              <Icon name="file" /><L en="Open the official PDF" hi="आधिकारिक PDF खोलें" />
            </a>
          </div>
        </div>
      ) : (
        <>
          <div class="toolbar no-print" data-pagefind-ignore>
            {showSections && groups.length > 1 && (
              <nav class="jump" aria-label="Sections">
                {groups.map((g) => (
                  <a class="chip" href={`#${g.anchor}`}>
                    {g.section ? <L t={sectionLabel(g.section)} /> : <L en="Questions" hi="प्रश्न" />}
                  </a>
                ))}
              </nav>
            )}
            <div class="tools">
              {s.solution_count > 0 && (
                <button class="btn" type="button" data-answers-toggle aria-pressed="false">
                  <span class="when-off"><Icon name="eye" /><L en="Show all answers" hi="सभी उत्तर दिखाएं" /></span>
                  <span class="when-on"><Icon name="eye-off" /><L en="Hide all answers" hi="सभी उत्तर छिपाएं" /></span>
                </button>
              )}
              <button class="btn btn-quiet" type="button" data-print>
                <Icon name="printer" /><L en="Print" hi="प्रिंट" />
              </button>
            </div>
          </div>

          {s.solution_count > 0 ? (
            <p class="note" data-pagefind-ignore>
              <Icon name="shield" />
              <span>
                <L
                  t={{
                    en: `Answers are reproduced from the official ${info.body.en} marking scheme. Questions without an answer had no unambiguous match in it.`,
                    hi: `उत्तर ${info.body.hi} की आधिकारिक अंकन योजना से लिए गए हैं। जिन प्रश्नों के उत्तर नहीं हैं, उनका उसमें स्पष्ट मिलान नहीं मिला।`,
                  }}
                />
              </span>
            </p>
          ) : paper.solution_pdf ? (
            <p class="note" data-pagefind-ignore>
              <Icon name="file-check" />
              <span>
                <L en="Answers for this paper are in the official marking scheme:" hi="इस प्रश्नपत्र के उत्तर आधिकारिक अंकन योजना में हैं:" />{' '}
                <a href={paper.solution_pdf} rel="noopener" target="_blank"><L en="open marking scheme PDF" hi="अंकन योजना PDF खोलें" /></a>
              </span>
            </p>
          ) : null}

          <div class="questions" lang={contentLang}>
            {groups.map((g) => (
              <section class="group" aria-labelledby={showSections ? g.anchor : undefined}>
                {showSections && (
                  <h2 class="group-h" id={g.anchor}>
                    {g.section ? <L t={sectionLabel(g.section)} /> : <L en="Questions" hi="प्रश्न" />}
                    <span class="group-meta" data-pagefind-ignore>
                      <L t={countLabel(g.questions.length, ...QUESTIONS)} />
                      {groupMarks(g) !== null && <> · <L t={marksLabel(groupMarks(g)!)} /></>}
                    </span>
                  </h2>
                )}
                <ol class="qlist" role="list">
                  {g.questions.map(({ q, anchor }) => (
                    <li class="q">
                      <div class="q-head">
                        <h3 class="q-num" id={anchor}>Q{q.number}</h3>
                        {q.marks !== null && <span class="badge" data-pagefind-ignore><L t={marksLabel(q.marks)} /></span>}
                        <a class="q-link no-print" href={`#${anchor}`} data-pagefind-ignore aria-label={`Link to question ${q.number}`}>
                          <Icon name="link" />
                        </a>
                      </div>
                      <div class="q-text">{q.text}</div>
                      {q.has_figure && (
                        <p class="figure" data-pagefind-ignore>
                          <Icon name="image" />
                          <span>
                            <L en="This question has a figure, diagram or table." hi="इस प्रश्न में चित्र, आरेख या तालिका है।" />{' '}
                            <a href={pdfAt(paper.paper_pdf, q.page)} rel="noopener" target="_blank">
                              {q.page ? (
                                <L t={{ en: `See page ${q.page} of the PDF`, hi: `PDF का पेज ${q.page} देखें` }} />
                              ) : (
                                <L en="See the PDF" hi="PDF देखें" />
                              )}
                            </a>
                          </span>
                        </p>
                      )}
                      {q.solution && (
                        <details class="answer">
                          <summary data-pagefind-ignore>
                            <Icon name="chevron" class="chev" />
                            <L en="Answer" hi="उत्तर" />
                            <span class="src"><L en="official marking scheme" hi="आधिकारिक अंकन योजना" /></span>
                          </summary>
                          <div class="answer-body">{q.solution}</div>
                        </details>
                      )}
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
        </>
      )}
    </article>

    <p class="report no-print">
      <Icon name="flag" />
      <span>
        <L en="Spotted a mistake in this page?" hi="इस पेज में कोई गलती दिखी?" />{' '}
        <a href={issueUrl} rel="noopener"><L en="Report it" hi="हमें बताएं" /></a>
      </span>
    </p>
  </div>

  {siblings.length > 0 && (
    <section class="container section more no-print" aria-labelledby="more-h">
      <div class="section-head">
        <h2 id="more-h"><L t={{ en: `More ${subj.en} papers`, hi: `${subj.hi} के और प्रश्नपत्र` }} /></h2>
        <a href={subjectUrl(paper.board, paper.class, paper.subject_slug)}>
          <L t={{ en: `All ${info.short} Class ${paper.class} ${subj.en} papers`, hi: `${info.short} कक्षा ${paper.class} ${subj.hi} के सभी प्रश्नपत्र` }} />
        </a>
      </div>
      <div class="grid">{siblings.map((p) => <PaperCard paper={p} />)}</div>
    </section>
  )}
</Base>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-answers-toggle]');
  if (toggle) {
    const answers = [...document.querySelectorAll<HTMLDetailsElement>('details.answer')];
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-pressed') !== 'true';
      for (const d of answers) d.open = open;
      toggle.setAttribute('aria-pressed', String(open));
    });
  }
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .narrow {
    max-width: 52rem;
  }

  .paper-head {
    padding: 1.5rem 0 0.5rem;
  }

  .paper-head h1 {
    margin: 0.75rem 0 0.4rem;
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.3rem);
  }

  .orig {
    color: var(--ink-2);
    margin-bottom: 1.1rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0 0 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    overflow: hidden;
  }

  .facts div {
    flex: 1 1 8rem;
    padding: 0.6rem 0.9rem;
    border-right: 1px solid var(--line);
    margin-right: -1px;
  }

  .facts dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .callout {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1.4rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .callout :global(.callout-icon) {
    flex: none;
    width: 30px;
    height: 30px;
    color: var(--accent);
  }

  .callout h2 {
    font-size: 1.15rem;
    margin-bottom: 0.3rem;
  }

  .callout p {
    color: var(--ink-2);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--line);
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tools {
    display: flex;
    gap: 0.4rem;
    margin-left: auto;
  }

  [data-answers-toggle] .when-on,
  [data-answers-toggle][aria-pressed='true'] .when-off {
    display: none;
  }

  [data-answers-toggle][aria-pressed='true'] .when-on,
  .when-off {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .note,
  .report {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.925rem;
    color: var(--ink-2);
  }

  .note {
    margin: 1rem 0 0;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--good-soft);
  }

  .note :global(svg),
  .report :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 0.2rem;
  }

  .note :global(svg) {
    color: var(--good);
  }

  .group {
    margin-top: 2rem;
  }

  .group-h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: 1.3rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 0.25rem;
    scroll-margin-top: 120px;
  }

  .group-meta {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--muted);
  }

  .qlist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .q {
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
  }

  .q-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }

  .q-num {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
    color: var(--accent);
    scroll-margin-top: 120px;
  }

  .q-link {
    margin-left: auto;
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.15s;
  }

  .q:hover .q-link,
  .q-link:focus-visible {
    opacity: 1;
  }

  @media (hover: none) {
    .q-link {
      opacity: 0.6;
    }
  }

  .q-link :global(svg) {
    width: 16px;
    height: 16px;
  }

  .q-text,
  .answer-body {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .figure {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--warn-soft);
    color: var(--ink-2);
    font-size: 0.925rem;
  }

  .figure :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 0.2rem;
    color: var(--warn);
  }

  .answer {
    margin-top: 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .answer summary {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.4rem 0.85rem;
    cursor: pointer;
    font-weight: 700;
    color: var(--good);
    list-style: none;
    user-select: none;
  }

  .answer summary::-webkit-details-marker {
    display: none;
  }

  .answer :global(.chev) {
    width: 18px;
    height: 18px;
    transform: rotate(-90deg);
    transition: transform 0.15s;
  }

  .answer[open] :global(.chev) {
    transform: none;
  }

  .answer .src {
    margin-left: auto;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--muted);
  }

  .answer-body {
    padding: 0.2rem 0.95rem 0.9rem;
    border-top: 1px dashed var(--line);
    padding-top: 0.7rem;
  }

  .report {
    margin: 2rem 0 0;
    color: var(--muted);
  }

  .more {
    padding-top: 2.5rem;
  }

  @media print {
    .answer:not([open]) {
      display: none;
    }

    .q {
      break-inside: avoid;
    }

    .paper-head h1 {
      font-size: 1.5rem;
    }
  }
</style>
