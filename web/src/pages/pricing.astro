---
import Base from '../layouts/Base.astro';
import L from '../components/L.astro';
import PricingLadder from '../components/PricingLadder.astro';
import { EXAMS, EXAM_INFO, type Exam } from '../lib/exams.ts';
import { BUNDLES, BUNDLE_INFO, bundleLink, rupees } from '../lib/pricing.ts';
import { href } from '../lib/url.ts';
---
<Base title="Pricing: most-probable sets, fast-track plans and bundles" page="pricing" description="Per exam: most-probable set ₹249, 2-month fast-track ₹499, 3-month fast-track (full Pass) ₹999. TRE + CTET and TRE + STET bundles ₹799.">
  <section class="container block">
    <h1><L en="Pricing" hi="कीमत" /></h1>
    <p class="muted lead"><L en="The same simple ladder for every exam. Pay once; no subscription. The free questions stay free." hi="हर परीक्षा के लिए एक जैसी सरल कीमतें। एक बार भुगतान; कोई सब्सक्रिप्शन नहीं। मुफ़्त प्रश्न हमेशा मुफ़्त।" /></p>

    <div class="panel picker">
      <label class="field" for="exam-pick"><span><L en="Choose your exam" hi="अपनी परीक्षा चुनें" /></span>
        <select id="exam-pick" data-exam-pick>
          {EXAMS.map((e) => <option value={e}>{EXAM_INFO[e].short.en} · {EXAM_INFO[e].short.hi}</option>)}
        </select>
      </label>
    </div>

    {EXAMS.map((e, i) => (
      <div class="exam-ladder" data-ladder={e} hidden={i !== 0}>
        <PricingLadder exam={e as Exam} bundles={false} />
      </div>
    ))}
  </section>

  <section class="container block" aria-labelledby="bundles-h">
    <h2 id="bundles-h"><L en="Bundles for teacher exams" hi="शिक्षक परीक्षाओं के बंडल" /></h2>
    <div class="bundles">
      {BUNDLES.map((b) => {
        const info = BUNDLE_INFO[b];
        const link = bundleLink(b);
        return (
          <article class="panel">
            <h3 class="h-sm"><L t={info.name} /> <span class="price">{rupees(info.price)}</span></h3>
            <p class="muted"><L t={info.summary} /></p>
            <a class="btn btn-primary" href={link.href} data-buy={`bundle-${b}`} data-exam={info.exams.join('+')} data-price={info.price}><L en="Buy bundle" hi="बंडल खरीदें" /></a>
          </article>
        );
      })}
    </div>
  </section>

  <section class="container block">
    <div class="panel small">
      <ul class="facts">
        <li><L en="Access is for the current exam cycle and is linked to your phone number." hi="एक्सेस मौजूदा परीक्षा चक्र के लिए है और आपके फ़ोन नंबर से जुड़ा है।" /></li>
        <li><L en="7-day refund policy." hi="7 दिन की रिफ़ंड नीति।" /> <a href={href('/refund/')}><L en="Read it" hi="पढ़ें" /></a></li>
        <li><L en="We never promise selection. Our job is good practice; the hard work is yours." hi="हम चयन का वादा नहीं करते। हमारा काम अच्छा अभ्यास देना है; मेहनत आपकी।" /></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  const pick = document.querySelector<HTMLSelectElement>('[data-exam-pick]');
  const show = (e: string) => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-ladder]')) el.hidden = el.dataset.ladder !== e;
  };
  const fromUrl = new URLSearchParams(location.search).get('exam');
  if (pick) {
    if (fromUrl && [...pick.options].some((o) => o.value === fromUrl)) pick.value = fromUrl;
    show(pick.value);
    pick.addEventListener('change', () => show(pick.value));
  }
</script>

<style>
  .lead {
    max-width: 60ch;
  }
  .picker {
    max-width: 420px;
    margin-bottom: 1rem;
  }
  .bundles {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .bundles {
      grid-template-columns: 1fr 1fr;
    }
  }
  .bundles .panel + .panel {
    margin-top: 0;
  }
  .bundles .price {
    color: var(--accent);
    margin-left: 0.3rem;
  }
</style>
