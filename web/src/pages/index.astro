---
import Base from '../layouts/Base.astro';
import L from '../components/L.astro';
import Icon from '../components/Icon.astro';
import SearchBox from '../components/SearchBox.astro';
import PaperCard from '../components/PaperCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { BOARDS } from '../lib/schema.ts';
import { BOARD_INFO, PAPERS, classLabel, countLabel, type Bi } from '../lib/boards.ts';
import { recentPapers, totals } from '../lib/catalog.ts';
import { boardUrl, classUrl, href } from '../lib/url.ts';
import { DESCRIPTION, REPO_URL, SITE_NAME, TAGLINE } from '../config.ts';

const t = totals();
const recent = recentPapers(6);

const jump: { label: Bi; url: string }[] = [
  ['cbse', 10],
  ['cbse', 12],
  ['icse', 10],
  ['isc', 12],
  ['up', 10],
  ['up', 12],
  ['bihar', 10],
  ['bihar', 12],
].map(([b, c]) => {
  const board = BOARD_INFO[b as keyof typeof BOARD_INFO];
  const cls = c as number;
  const alias = board.aliases?.[cls];
  const label = alias ?? classLabel(cls);
  return { label: { en: `${board.short} ${label.en}`, hi: `${board.short} ${label.hi}` }, url: classUrl(board.slug, cls) };
});

const site = Astro.site;
const jsonLd = site
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_NAME,
      url: new URL(href('/'), site).href,
      description: DESCRIPTION,
      potentialAction: {
        '@type': 'SearchAction',
        target: `${new URL(href('/search/'), site).href}?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    }
  : undefined;
---
<Base title={`${SITE_NAME}: board exam papers with official answers`} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">CBSE · ICSE · ISC · UP Board · Bihar Board</p>
      <h1>
        <L en="Every board paper, straight from the source." hi="हर बोर्ड प्रश्नपत्र, सीधे स्रोत से।" />
      </h1>
      <p class="lead">
        <L
          en="Previous year papers, sample papers and model papers for classes 9–12. Answers come only from official marking schemes. Free, with no sign-up."
          hi="कक्षा 9–12 के पिछले वर्षों के प्रश्नपत्र, प्रतिदर्श प्रश्नपत्र और मॉडल प्रश्नपत्र। उत्तर केवल आधिकारिक अंकन योजनाओं से। निःशुल्क, बिना साइन-अप।"
        />
      </p>
      <SearchBox />
      {t.papers > 0 && (
        <ul class="stat-line hero-stats">
          <li><strong>{t.papers.toLocaleString('en-IN')}</strong> <L en="papers" hi="प्रश्नपत्र" /></li>
          {t.questions > 0 && <li><strong>{t.questions.toLocaleString('en-IN')}</strong> <L en="questions" hi="प्रश्न" /></li>}
          {t.answers > 0 && <li><strong>{t.answers.toLocaleString('en-IN')}</strong> <L en="official answers" hi="आधिकारिक उत्तर" /></li>}
          <li><strong>{t.subjects.toLocaleString('en-IN')}</strong> <L en="subjects" hi="विषय" /></li>
        </ul>
      )}
    </div>
  </section>

  <section class="container section" aria-labelledby="boards-h">
    <div class="section-head">
      <h2 id="boards-h"><L en="Choose your board" hi="अपना बोर्ड चुनें" /></h2>
    </div>
    <div class="boards">
      {BOARDS.map((b) => {
        const info = BOARD_INFO[b];
        const n = t.byBoard[b];
        return (
          <article class="card card-link board-card" style={`--board: var(--board-${b})`}>
            <span class="mono" aria-hidden="true">{info.short.replace(' Board', '')}</span>
            <div class="board-body">
              <h3><a class="stretched" href={boardUrl(b)}>{info.short}</a></h3>
              <p class="board-name"><L t={info.name} /></p>
              <p class="board-meta">
                <L t={{ en: `Classes ${info.classes[0]}–${info.classes.at(-1)}`, hi: `कक्षा ${info.classes[0]}–${info.classes.at(-1)}` }} />
                {' · '}
                {n > 0 ? <L t={countLabel(n, ...PAPERS)} /> : <L en="Coming soon" hi="जल्द आ रहा है" />}
              </p>
            </div>
            <Icon name="arrow-right" class="board-arrow" />
          </article>
        );
      })}
    </div>
  </section>

  <section class="container section tight" aria-labelledby="jump-h">
    <h2 id="jump-h" class="small-h"><L en="Jump to your class" hi="अपनी कक्षा पर जाएं" /></h2>
    <ul class="chips">
      {jump.map((j) => <li><a class="chip" href={j.url}><L t={j.label} /></a></li>)}
    </ul>
  </section>

  <section class="container section" aria-labelledby="recent-h">
    <div class="section-head">
      <h2 id="recent-h"><L en="Recently added" hi="हाल ही में जोड़े गए" /></h2>
      {recent.length > 0 && <a href={href('/search/')}><L en="Search all papers" hi="सभी प्रश्नपत्र खोजें" /></a>}
    </div>
    {recent.length > 0 ? (
      <div class="grid">{recent.map((p) => <PaperCard paper={p} full />)}</div>
    ) : (
      <EmptyState title={{ en: 'The archive is being built', hi: 'संग्रह तैयार किया जा रहा है' }}>
        <p>
          <L
            en="Papers appear here as soon as they are collected from the boards’ official websites. Check back soon."
            hi="बोर्डों की आधिकारिक वेबसाइटों से एकत्र होते ही प्रश्नपत्र यहां दिखेंगे। जल्द ही दोबारा देखें।"
          />
        </p>
      </EmptyState>
    )}
  </section>

  <section class="container section" aria-labelledby="why-h">
    <h2 id="why-h" class="sr-only"><L en="Why Prashnottar" hi="प्रश्नोत्तर क्यों" /></h2>
    <div class="why">
      <div>
        <Icon name="shield" class="why-icon" />
        <h3><L en="Official sources only" hi="केवल आधिकारिक स्रोत" /></h3>
        <p>
          <L
            en="Every paper links to the PDF on the board’s own website. Nothing is copied from coaching or guide-book sites."
            hi="हर प्रश्नपत्र बोर्ड की अपनी वेबसाइट के PDF से जुड़ा है। कोचिंग या गाइड-बुक साइटों से कुछ नहीं लिया गया।"
          />
        </p>
      </div>
      <div>
        <Icon name="file-check" class="why-icon" />
        <h3><L en="Answers you can trust" hi="भरोसेमंद उत्तर" /></h3>
        <p>
          <L
            en="Answers are shown only when they come from the board’s marking scheme and match the question exactly."
            hi="उत्तर तभी दिखाए जाते हैं जब वे बोर्ड की अंकन योजना से हों और प्रश्न से ठीक मेल खाते हों।"
          />
        </p>
      </div>
      <div>
        <Icon name="phone" class="why-icon" />
        <h3><L en="Fast on any phone" hi="हर फ़ोन पर तेज़" /></h3>
        <p>
          <L
            en="Pages are small and load quickly on slow connections, in English or Hindi. No app, no login, no ads."
            hi="पेज हल्के हैं और धीमे नेटवर्क पर भी जल्दी खुलते हैं, हिन्दी या अंग्रेज़ी में। न ऐप, न लॉगिन, न विज्ञापन।"
          />
        </p>
      </div>
    </div>
    <p class="muted foot-note">
      <L t={TAGLINE} />. <a href={href('/about/')}><L en="How it works" hi="यह कैसे काम करता है" /></a> ·
      <a href={REPO_URL} rel="noopener"><L en="Open source on GitHub" hi="GitHub पर ओपन सोर्स" /></a>
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.25rem, 1.5rem + 4vw, 4.5rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background:
      radial-gradient(60rem 22rem at 85% -10%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%),
      linear-gradient(to bottom, transparent, transparent);
    border-bottom: 1px solid var(--line);
  }

  .hero h1 {
    max-width: 18ch;
    margin-bottom: 0.75rem;
  }

  :global(:root[data-ui='hi']) .hero h1 {
    max-width: 22ch;
  }

  .hero .lead {
    margin-bottom: 1.5rem;
  }

  .hero-stats {
    margin-top: 1.1rem;
  }

  .tight {
    padding-block: 0 0.5rem;
  }

  .small-h {
    font-size: 1rem;
    color: var(--ink-2);
    margin-bottom: 0.75rem;
  }

  .boards {
    display: grid;
    gap: 0.875rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .board-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
  }

  .mono {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--board) 13%, var(--surface));
    color: var(--board);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .board-body {
    flex: 1;
    min-width: 0;
  }

  .board-body h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .board-name {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.925rem;
    line-height: 1.35;
  }

  .board-meta {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .board-card :global(.board-arrow) {
    flex: none;
    width: 20px;
    color: var(--muted);
    transition: transform 0.15s, color 0.15s;
  }

  .board-card:hover :global(.board-arrow) {
    transform: translateX(3px);
    color: var(--board);
  }

  .why {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    padding: 1.75rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .why h3 {
    margin: 0.65rem 0 0.3rem;
  }

  .why p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.975rem;
  }

  .why :global(.why-icon) {
    width: 28px;
    height: 28px;
    color: var(--accent);
  }

  .foot-note {
    margin: 1rem 0 0;
    font-size: 0.925rem;
  }
</style>
