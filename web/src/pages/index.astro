---
import Base from '../layouts/Base.astro';
import L from '../components/L.astro';
import Icon from '../components/Icon.astro';
import { EXAMS, EXAM_INFO, PASS_PRICE, papersFor, questionCount } from '../lib/exams.ts';
import { examUrl, practiceUrl, pricingUrl, testUrl } from '../lib/url.ts';
import { SITE_NAME } from '../config.ts';

const firstFree = (e: (typeof EXAMS)[number]) => papersFor(e).find((p) => p.free);
---
<Base title={`${SITE_NAME}: BPSC TRE, Bihar Daroga, BPSC Prelims and UP SI practice`}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">BPSC TRE · Bihar Daroga · BPSC Prelims · UP SI</p>
      <h1>
        <L en="Practise like it’s exam day." hi="ऐसे अभ्यास करें, जैसे आज ही परीक्षा हो।" />
      </h1>
      <p class="lead">
        <L
          en="Exam-style question papers, timed mock tests and topic practice with explanations, in Hindi and English. Start with a free practice set for your exam."
          hi="परीक्षा जैसे प्रश्नपत्र, समयबद्ध मॉक टेस्ट और व्याख्या सहित विषयवार अभ्यास, हिन्दी और अंग्रेज़ी में। अपनी परीक्षा के निःशुल्क अभ्यास सेट से शुरू करें।"
        />
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#exams-h"><L en="Choose your exam" hi="अपनी परीक्षा चुनें" /> <Icon name="arrow-right" /></a>
        <a class="btn btn-quiet" href={pricingUrl()}><L t={{ en: `All 4 exams for ₹${PASS_PRICE.toLocaleString('en-IN')}`, hi: `चारों परीक्षाएं ₹${PASS_PRICE.toLocaleString('en-IN')} में` }} /></a>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="exams-h">
    <div class="section-head">
      <h2 id="exams-h"><L en="Choose your exam" hi="अपनी परीक्षा चुनें" /></h2>
    </div>
    <div class="exams">
      {EXAMS.map((e) => {
        const info = EXAM_INFO[e];
        const free = firstFree(e);
        return (
          <article class="card exam-card" style={`--exam: var(--exam-${e})`}>
            <div class="exam-top">
              <span class="state"><L t={info.state} /></span>
              <h3><a href={examUrl(e)}><L t={info.short} /></a></h3>
              <p class="exam-name"><L t={info.name} /></p>
              <p class="exam-blurb"><L t={info.blurb} /></p>
            </div>
            <div class="exam-actions">
              {free ? (
                <>
                  <a class="btn btn-primary" href={practiceUrl(e, free.id)}><Icon name="target" /><L en="Free practice" hi="निःशुल्क अभ्यास" /></a>
                  <a class="btn btn-quiet" href={testUrl(e, free.id)}><Icon name="clock" /><L en="Mock test" hi="मॉक टेस्ट" /></a>
                </>
              ) : (
                <a class="btn btn-quiet" href={examUrl(e)}><L en="See exam" hi="परीक्षा देखें" /></a>
              )}
            </div>
            {free && (
              <p class="exam-meta">
                <L t={{ en: `Free set: ${questionCount(free)} questions`, hi: `निःशुल्क सेट: ${questionCount(free)} प्रश्न` }} />
              </p>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <section class="container section" aria-labelledby="modes-h">
    <h2 id="modes-h"><L en="Three ways to prepare" hi="तैयारी के तीन तरीके" /></h2>
    <div class="why">
      <div>
        <Icon name="target" class="why-icon" />
        <h3><L en="Practice mode" hi="अभ्यास मोड" /></h3>
        <p>
          <L
            en="One question at a time. See the right answer and why straight away, and track your weak topics."
            hi="एक बार में एक प्रश्न। सही उत्तर और उसकी व्याख्या तुरंत देखें, और अपने कमज़ोर विषय पहचानें।"
          />
        </p>
      </div>
      <div>
        <Icon name="clock" class="why-icon" />
        <h3><L en="Mock test" hi="मॉक टेस्ट" /></h3>
        <p>
          <L
            en="A timed test with a question palette, mark-for-review and a full score report, like the real computer-based exam."
            hi="प्रश्न पैलेट, समीक्षा हेतु चिह्नित और पूरी स्कोर रिपोर्ट के साथ समयबद्ध टेस्ट, असली परीक्षा की तरह।"
          />
        </p>
      </div>
      <div>
        <Icon name="file" class="why-icon" />
        <h3><L en="Question paper" hi="प्रश्नपत्र" /></h3>
        <p>
          <L
            en="The full paper laid out like an exam booklet, in Hindi and English. Print it and solve it on paper."
            hi="पूरा प्रश्नपत्र परीक्षा पुस्तिका की तरह, हिन्दी और अंग्रेज़ी में। प्रिंट करें और कागज़ पर हल करें।"
          />
        </p>
      </div>
    </div>
  </section>

  <section class="container section" aria-labelledby="pass-h">
    <div class="pass card">
      <div>
        <h2 id="pass-h"><L en="One Pass, all four exams" hi="एक पास, चारों परीक्षाएं" /></h2>
        <p class="muted">
          <L
            en="Full mock tests, topic-wise practice and solved past papers for BPSC TRE, Bihar Daroga, BPSC Prelims and UP SI."
            hi="बीपीएससी टीआरई, बिहार दरोगा, बीपीएससी प्रारंभिक और यूपी एसआई के लिए पूर्ण मॉक टेस्ट, विषयवार अभ्यास और हल सहित पिछले प्रश्नपत्र।"
          />
        </p>
      </div>
      <div class="pass-price">
        <strong>₹{PASS_PRICE.toLocaleString('en-IN')}</strong>
        <a class="btn btn-primary" href={pricingUrl()}><L en="See what’s included" hi="क्या-क्या मिलेगा" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.25rem, 1.5rem + 4vw, 4.5rem) clamp(1.75rem, 1rem + 2vw, 2.75rem);
    background: radial-gradient(60rem 22rem at 85% -10%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%);
    border-bottom: 1px solid var(--line);
  }

  .hero h1 {
    max-width: 18ch;
    margin-bottom: 0.75rem;
  }

  :global(:root[data-ui='hi']) .hero h1 {
    max-width: 22ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .exams {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  .exam-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.2rem 1.2rem 1rem;
    border-top: 4px solid var(--exam);
  }

  .exam-top {
    flex: 1;
  }

  .state {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--exam);
  }

  .exam-card h3 {
    margin: 0.15rem 0 0.1rem;
    font-size: 1.35rem;
  }

  .exam-card h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .exam-card h3 a:hover {
    color: var(--exam);
    text-decoration: underline;
  }

  .exam-name {
    margin: 0 0 0.5rem;
    color: var(--ink-2);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .exam-blurb {
    margin: 0;
    color: var(--muted);
    font-size: 0.925rem;
  }

  .exam-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .exam-meta {
    margin: 0;
    font-size: 0.825rem;
    color: var(--muted);
  }

  .why {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    padding: 1.75rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .why h3 {
    margin: 0.65rem 0 0.3rem;
  }

  .why p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.975rem;
  }

  .why :global(.why-icon) {
    width: 28px;
    height: 28px;
    color: var(--accent);
  }

  .pass {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    background: var(--accent-soft);
    border-color: transparent;
  }

  .pass h2 {
    margin: 0 0 0.35rem;
  }

  .pass p {
    margin: 0;
    max-width: 40rem;
  }

  .pass-price {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pass-price strong {
    font-size: 2rem;
    font-weight: 800;
    color: var(--ink);
  }
</style>
