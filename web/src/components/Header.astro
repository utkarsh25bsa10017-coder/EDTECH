---
import { EXAMS, EXAM_INFO, type Exam } from '../lib/exams.ts';
import { examUrl, href, pricingUrl } from '../lib/url.ts';
import { SITE_NAME, SITE_NAME_HI } from '../config.ts';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import L from './L.astro';

interface Props {
  exam?: Exam;
  page?: 'pricing';
}
const { exam, page } = Astro.props;
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href('/')}>
      <Logo size={34} />
      <span class="brand-text">
        <span class="brand-name">{SITE_NAME}</span>
        <span class="brand-hi" lang="hi">{SITE_NAME_HI}</span>
      </span>
    </a>
    <div class="actions">
      <button class="lang-btn" type="button" data-lang-toggle>
        <span class="l-en" lang="hi">हिन्दी</span>
        <span class="l-hi" lang="en">English</span>
      </button>
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        aria-label="Switch light or dark theme"
        data-label-en="Switch light or dark theme"
        data-label-hi="लाइट या डार्क थीम बदलें"
      >
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
    </div>
  </div>
  <nav class="board-nav" aria-label="Exams">
    <div class="container board-row">
      {EXAMS.map((e) => (
        <a href={examUrl(e)} aria-current={exam === e ? 'page' : undefined}>
          <L t={EXAM_INFO[e].short} />
        </a>
      ))}
      <span class="sep" aria-hidden="true"></span>
      <a class="pass-link" href={pricingUrl()} aria-current={page === 'pricing' ? 'page' : undefined}>
        <L en="Get the Pass" hi="पास लें" />
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 60px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .brand-name {
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.015em;
  }

  .brand-hi {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 600;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .lang-btn {
    min-height: 36px;
    padding: 0.2rem 0.8rem;
    margin-inline: 0.2rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .lang-btn:hover {
    border-color: var(--ink-2);
  }

  .actions :global(.i-sun) {
    display: none;
  }

  :global(:root[data-theme='dark']) .actions :global(.i-sun) {
    display: block;
  }

  :global(:root[data-theme='dark']) .actions :global(.i-moon) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .actions :global(.i-sun) {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .actions :global(.i-moon) {
      display: none;
    }
  }

  .board-nav {
    border-top: 1px solid var(--line);
  }

  .board-row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    min-height: 44px;
  }

  .board-row::-webkit-scrollbar {
    display: none;
  }

  .board-row a {
    flex: none;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    color: var(--ink-2);
    font-weight: 600;
    font-size: 0.925rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .board-row a:first-child {
    margin-left: -0.7rem;
  }

  .board-row a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  .board-row a[aria-current='page'] {
    color: var(--ink);
    background: var(--surface-2);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 999px 999px 6px 6px;
  }

  .board-row a.pass-link {
    color: var(--accent);
  }

  .sep {
    flex: none;
    width: 1px;
    height: 18px;
    background: var(--line-strong);
    margin-inline: 0.3rem;
  }
</style>
