---
import { EXAMS, EXAM_INFO, type Exam } from '../lib/exams.ts';
import { accountUrl, examUrl, href, pricingUrl } from '../lib/url.ts';
import { SITE_NAME, SITE_NAME_HI } from '../config.ts';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import L from './L.astro';

interface Props {
  exam?: Exam;
  page?: string;
}
const { exam, page } = Astro.props;
---
<header class="site-header glass-bar">
  <div class="container bar">
    <a class="brand" href={href('/')}>
      <Logo size={32} />
      <span class="brand-text">
        <span class="brand-name">{SITE_NAME}</span>
        <span class="brand-hi" lang="hi">{SITE_NAME_HI}</span>
      </span>
    </a>
    <div class="actions">
      <button class="chip lang-btn" type="button" data-lang-toggle>
        <span class="l-en" lang="hi">हिन्दी</span>
        <span class="l-hi" lang="en">English</span>
      </button>
      <a class="icon-btn" href={accountUrl()} aria-current={page === 'account' ? 'page' : undefined} data-label-en="Your account" data-label-hi="आपका खाता" aria-label="Your account">
        <Icon name="user" size={20} />
      </a>
      <button
        class="icon-btn theme-btn"
        type="button"
        data-theme-toggle
        aria-label="Switch light or dark theme"
        data-label-en="Switch light or dark theme"
        data-label-hi="लाइट या डार्क थीम बदलें"
      >
        <Icon name="moon" class="i-moon" size={20} />
        <Icon name="sun" class="i-sun" size={20} />
      </button>
    </div>
  </div>
  <nav class="exam-nav" aria-label="Exams">
    <div class="container exam-row">
      {EXAMS.map((e) => (
        <a href={examUrl(e)} aria-current={exam === e ? 'page' : undefined}>
          <L t={EXAM_INFO[e].short} />
        </a>
      ))}
      <a class="progress-link" href={href('/progress/')} aria-current={page === 'progress' ? 'page' : undefined} data-progress-link hidden>
        <L en="Progress" hi="प्रगति" />
      </a>
      <a class="pricing-link" href={pricingUrl()} aria-current={page === 'pricing' ? 'page' : undefined}>
        <L en="Pricing" hi="कीमत" />
      </a>
    </div>
  </nav>
</header>

<script>
  // The Progress link is for signed-in students (the session is cached at sign-in).
  import { cachedUser } from '../scripts/api.ts';
  const link = document.querySelector<HTMLElement>('[data-progress-link]');
  if (link && (cachedUser() || link.getAttribute('aria-current') === 'page')) link.hidden = false;
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 58px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    min-height: var(--tap);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .brand-name {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .brand-hi {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 600;
    line-height: 1.3;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .actions .icon-btn {
    color: var(--ink-2);
  }
  .actions :global(.i-sun) {
    display: none;
  }
  :global(:root[data-theme='dark']) .actions :global(.i-sun) {
    display: block;
  }
  :global(:root[data-theme='dark']) .actions :global(.i-moon) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .actions :global(.i-sun) {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .actions :global(.i-moon) {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .theme-btn {
      display: none;
    }
  }
  .exam-nav {
    border-top: 1px solid var(--line);
  }
  .exam-row {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    overflow-x: auto;
    scrollbar-width: none;
    min-height: 46px;
  }
  .exam-row::-webkit-scrollbar {
    display: none;
  }
  .exam-row a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 0.75rem;
    border-radius: 999px;
    color: var(--ink-2);
    font-weight: 600;
    font-size: 0.93rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .exam-row a:first-child {
    margin-left: -0.75rem;
  }
  .exam-row a:hover {
    color: var(--ink);
    background: var(--panel-2);
  }
  .exam-row a[aria-current='page'] {
    color: var(--accent-ink);
    background: var(--accent);
  }
  .progress-link[hidden] {
    display: none !important;
  }
  .progress-link {
    margin-left: auto;
  }
  .pricing-link {
    border: 1px solid var(--line-strong);
  }
  .progress-link[hidden] + .pricing-link {
    margin-left: auto;
  }
</style>
