---
import { EXAMS, EXAM_INFO } from '../lib/exams.ts';
import { accountUrl, examUrl, href, pricingUrl } from '../lib/url.ts';
import { SITE_NAME, whatsappUrl } from '../config.ts';
import L from './L.astro';

const wa = whatsappUrl('Hi Prashnottar, I have a question.');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container foot-grid">
    <div>
      <p class="foot-brand">{SITE_NAME}</p>
      <p class="muted small">
        <L
          en="Prashnottar is an independent practice platform. We are not affiliated with, endorsed by or connected to BPSC, MPPSC, RPSC, BSEB, CBSE, CG Vyapam or any government body. Always check dates and patterns in the official notice."
          hi="प्रश्नोत्तर एक स्वतंत्र अभ्यास मंच है। हमारा बीपीएससी, एमपीपीएससी, आरपीएससी, बीएसईबी, सीबीएसई, सीजी व्यापम या किसी सरकारी संस्था से कोई संबंध नहीं है। तिथियां और पैटर्न हमेशा आधिकारिक सूचना में जांचें।"
        />
      </p>
    </div>
    <nav aria-label="Exams">
      <p class="foot-h"><L en="Exams" hi="परीक्षाएं" /></p>
      <ul>
        {EXAMS.map((e) => <li><a href={examUrl(e)}><L t={EXAM_INFO[e].short} /></a></li>)}
      </ul>
    </nav>
    <nav aria-label="Help">
      <p class="foot-h"><L en="Help" hi="सहायता" /></p>
      <ul>
        <li><a href={pricingUrl()}><L en="Pricing" hi="कीमत" /></a></li>
        <li><a href={accountUrl()}><L en="Your account" hi="आपका खाता" /></a></li>
        <li><a href={href('/contact/')}><L en="Contact" hi="संपर्क" /></a></li>
        {wa && <li><a href={wa} target="_blank" rel="noopener"><L en="WhatsApp us" hi="व्हाट्सऐप करें" /></a></li>}
      </ul>
    </nav>
    <nav aria-label="Policies">
      <p class="foot-h"><L en="Policies" hi="नीतियां" /></p>
      <ul>
        <li><a href={href('/terms/')}><L en="Terms" hi="नियम व शर्तें" /></a></li>
        <li><a href={href('/privacy/')}><L en="Privacy" hi="गोपनीयता" /></a></li>
        <li><a href={href('/refund/')}><L en="Refunds" hi="रिफ़ंड" /></a></li>
      </ul>
    </nav>
  </div>
  <div class="container"><p class="muted small copy">© {year} [BUSINESS NAME]</p></div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    padding: 2rem 0 calc(1.5rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
  }
  .foot-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr 1fr;
  }
  .foot-grid > div:first-child {
    grid-column: 1 / -1;
  }
  @media (min-width: 860px) {
    .foot-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
    .foot-grid > div:first-child {
      grid-column: auto;
    }
  }
  .foot-brand {
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  .foot-h {
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.3rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--ink-2);
    text-decoration: none;
  }
  li a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .copy {
    margin-top: 1.5rem;
  }
</style>
