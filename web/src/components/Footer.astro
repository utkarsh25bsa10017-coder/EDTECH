---
import { BOARDS } from '../lib/schema.ts';
import { BOARD_INFO } from '../lib/boards.ts';
import { boardUrl, href } from '../lib/url.ts';
import { REPO_URL, SITE_NAME, SITE_NAME_HI, TAGLINE } from '../config.ts';
import L from './L.astro';
import Logo from './Logo.astro';
---
<footer class="site-footer">
  <div class="container cols">
    <div class="about">
      <a class="brand" href={href('/')}>
        <Logo size={28} />
        <span><strong>{SITE_NAME}</strong> <span class="muted" lang="hi">{SITE_NAME_HI}</span></span>
      </a>
      <p class="muted"><L t={TAGLINE} /></p>
    </div>
    <nav aria-label="Boards">
      <h2><L en="Boards" hi="बोर्ड" /></h2>
      <ul>
        {BOARDS.map((b) => <li><a href={boardUrl(b)}>{BOARD_INFO[b].short}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Site">
      <h2><L en="Site" hi="साइट" /></h2>
      <ul>
        <li><a href={href('/search/')}><L en="Search" hi="खोजें" /></a></li>
        <li><a href={href('/about/')}><L en="About & sources" hi="परिचय और स्रोत" /></a></li>
        <li><a href={`${REPO_URL}/issues/new`} rel="noopener"><L en="Report a problem" hi="समस्या बताएं" /></a></li>
        <li><a href={REPO_URL} rel="noopener">GitHub</a></li>
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <p>
      <L
        en="Not affiliated with CBSE, CISCE, UPMSP or BSEB. Question papers and marking schemes belong to their respective boards; every PDF link points to the board’s own website."
        hi="सीबीएसई, सीआईएससीई, यूपीएमएसपी या बीएसईबी से संबद्ध नहीं। प्रश्नपत्र और अंकन योजनाएं संबंधित बोर्डों की हैं; हर PDF लिंक बोर्ड की अपनी वेबसाइट पर जाता है।"
      />
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.95rem;
  }

  .cols {
    display: grid;
    gap: 1.75rem;
    padding-block: 2.25rem 1.25rem;
    grid-template-columns: 1fr 1fr;
  }

  .about {
    grid-column: 1 / -1;
  }

  @media (min-width: 720px) {
    .cols {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .about {
      grid-column: auto;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 0.6rem;
  }

  .about p {
    max-width: 24rem;
    margin: 0;
  }

  h2 {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  ul a {
    color: var(--ink-2);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .legal {
    border-top: 1px solid var(--line);
    padding-block: 1rem 1.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .legal p {
    margin: 0;
    max-width: 52rem;
  }
</style>
