---
import { EXAMS, EXAM_INFO } from '../lib/exams.ts';
import { examUrl, href, pricingUrl } from '../lib/url.ts';
import { SITE_NAME, SITE_NAME_HI, TAGLINE } from '../config.ts';
import L from './L.astro';
import Logo from './Logo.astro';
---
<footer class="site-footer">
  <div class="container cols">
    <div class="about">
      <a class="brand" href={href('/')}>
        <Logo size={28} />
        <span><strong>{SITE_NAME}</strong> <span class="muted" lang="hi">{SITE_NAME_HI}</span></span>
      </a>
      <p class="muted"><L t={TAGLINE} /></p>
    </div>
    <nav aria-label="Exams">
      <h2><L en="Exams" hi="परीक्षाएं" /></h2>
      <ul>
        {EXAMS.map((e) => <li><a href={examUrl(e)}><L t={EXAM_INFO[e].short} /></a></li>)}
      </ul>
    </nav>
    <nav aria-label="Site">
      <h2><L en="Site" hi="साइट" /></h2>
      <ul>
        <li><a href={href('/')}><L en="Home" hi="होम" /></a></li>
        <li><a href={pricingUrl()}><L en="Pricing" hi="मूल्य" /></a></li>
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <p>
      <L
        en="Prashnottar is an independent practice platform, not affiliated with BPSC, BPSSC, UPPRPB or any government body. Practice papers are our own questions written in the exam pattern; always check the official notification for the exact syllabus and pattern."
        hi="प्रश्नोत्तर एक स्वतंत्र अभ्यास मंच है, बीपीएससी, बीपीएसएससी, यूपीपीआरपीबी या किसी सरकारी संस्था से संबद्ध नहीं। अभ्यास प्रश्नपत्र परीक्षा पैटर्न पर लिखे हमारे अपने प्रश्न हैं; सटीक पाठ्यक्रम और पैटर्न के लिए हमेशा आधिकारिक अधिसूचना देखें।"
      />
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.95rem;
  }

  .cols {
    display: grid;
    gap: 1.75rem;
    padding-block: 2.25rem 1.25rem;
    grid-template-columns: 1fr 1fr;
  }

  .about {
    grid-column: 1 / -1;
  }

  @media (min-width: 720px) {
    .cols {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .about {
      grid-column: auto;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 0.6rem;
  }

  .about p {
    max-width: 24rem;
    margin: 0;
  }

  h2 {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  ul a {
    color: var(--ink-2);
    text-decoration: none;
  }

  ul a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .legal {
    border-top: 1px solid var(--line);
    padding-block: 1rem 1.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .legal p {
    margin: 0;
    max-width: 52rem;
  }
</style>
