---
import L from './L.astro';
import { href } from '../lib/url.ts';
import type { Bi } from '../lib/boards.ts';

export interface Crumb {
  label: Bi;
  href: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const all: Crumb[] = [{ label: { en: 'Home', hi: 'होम' }, href: href('/') }, ...items];
const site = Astro.site;
const ld = site
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: all.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label.en,
        item: new URL(c.href, site).href,
      })),
    }).replace(/</g, '\\u003c')
  : null;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {all.map((c, i) => (
      <li>
        {i === all.length - 1 ? (
          <span aria-current="page"><L t={c.label} /></span>
        ) : (
          <a href={c.href}><L t={c.label} /></a>
        )}
      </li>
    ))}
  </ol>
</nav>
{ld && <script type="application/ld+json" set:html={ld} />}

<style>
  .crumbs {
    padding-top: 1.1rem;
    font-size: 0.9rem;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
  }

  li:not(:last-child)::after {
    content: '/';
    margin-inline: 0.5rem;
    color: var(--line-strong);
  }

  a {
    color: var(--ink-2);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  [aria-current] {
    color: var(--muted);
  }
</style>
