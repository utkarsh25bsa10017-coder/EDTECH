---
import L from './L.astro';
import { SYLLABUS } from '../lib/syllabus.ts';
import type { Exam } from '../lib/exams.ts';

interface Props {
  exam: Exam;
}
const { exam } = Astro.props;
const { stages, note } = SYLLABUS[exam];
---
<div class="syllabus">
  {stages.map((stage) => (
    <section class="stage">
      <h3 class="stage-name"><L t={stage.name} /></h3>
      <div class="papers">
        {stage.papers.map((p) => (
          <article class="card paper-box">
            <h4>
              <L t={p.name} />
              {p.note && <span class="badge outline"><L t={p.note} /></span>}
            </h4>
            <ul class="subj">
              {p.subjects.map((s) => <li><L t={s} /></li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>
  ))}
  {note && <p class="muted syl-note"><L t={note} /></p>}
</div>

<style>
  .syllabus {
    display: grid;
    gap: 1.25rem;
  }

  .stage-name {
    margin: 0 0 0.6rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--exam, var(--accent));
  }

  .papers {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  .paper-box {
    padding: 1rem 1.1rem;
    box-shadow: none;
  }

  .paper-box h4 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin: 0 0 0.55rem;
    font-size: 1.02rem;
  }

  .subj {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .subj li {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: 0.9rem;
  }

  .syl-note {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
