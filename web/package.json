{
  "name": "prashnottar-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Prashnottar: free board exam papers from official sources",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "seed": "node scripts/seed.ts",
    "dev": "npm run seed && astro dev",
    "dev:fixtures": "node scripts/seed.ts --papers-dir fixtures/papers && astro dev",
    "build": "npm run seed && astro build && pagefind",
    "build:fixtures": "node scripts/seed.ts --papers-dir fixtures/papers --strict && astro build && pagefind",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test test/",
    "test:smoke": "npm run build:fixtures && node test/smoke.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/mukta": "^5.3.0",
    "astro": "^7.4.7",
    "pagefind": "^1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  }
}
