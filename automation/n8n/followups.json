{
  "name": "Prashnottar: WhatsApp follow-ups",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "every-minute"
    },
    {
      "parameters": {
        "url": "={{ $env.PRASHNOTTAR_API }}/api/automation/followups",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.AUTOMATION_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Get due follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "id": "get-due-follow-ups"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Free-form text only inside WhatsApp's 24-hour window; otherwise an approved template.\nconst l = $json;\nif (!l.lead_id) return null;\nconst wa_body = l.window_open\n  ? { messaging_product: 'whatsapp', to: l.phone, type: 'text', text: { body: l.message, preview_url: true } }\n  : { messaging_product: 'whatsapp', to: l.phone, type: 'template',\n      template: { name: l.template_name, language: { code: 'hi' },\n        components: [{ type: 'body', parameters: l.template_params.map(t => ({ type: 'text', text: String(t) })) }] } };\nreturn { json: { ...l, wa_body } };"
      },
      "name": "Build message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "build-message"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.WHATSAPP_API_BASE || 'https://graph.facebook.com/v21.0') + '/' + $env.WHATSAPP_PHONE_NUMBER_ID + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Build message').item.json.wa_body) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "id": "send-whatsapp",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.statusCode >= 200 && $json.statusCode < 300 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        -80
      ],
      "id": "sent"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "tr",
              "leftValue": "={{ [408, 409, 429].includes($json.statusCode) || $json.statusCode >= 500 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Transient error?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        40
      ],
      "id": "transient-error"
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "name": "Wait 10 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        240
      ],
      "id": "wait-10-s"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PRASHNOTTAR_API }}/api/automation/followups/{{ $('Build message').item.json.lead_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.AUTOMATION_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ step: $('Build message').item.json.step, status: 'sent' }) }}",
        "options": {}
      },
      "name": "Mark sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -200
      ],
      "id": "mark-sent"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PRASHNOTTAR_API }}/api/automation/followups/{{ $('Build message').item.json.lead_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Key",
              "value": "={{ $env.AUTOMATION_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ step: $('Build message').item.json.step, status: 'failed' }) }}",
        "options": {}
      },
      "name": "Mark failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        40
      ],
      "id": "mark-failed"
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Get due follow-ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get due follow-ups": {
      "main": [
        [
          {
            "node": "Build message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build message": {
      "main": [
        [
          {
            "node": "Send WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp": {
      "main": [
        [
          {
            "node": "Sent?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 10 s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sent?": {
      "main": [
        [
          {
            "node": "Mark sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Transient error?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transient error?": {
      "main": [
        [
          {
            "node": "Wait 10 s",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 10 s": {
      "main": [
        [
          {
            "node": "Send WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "id": "prFollowups0001"
}